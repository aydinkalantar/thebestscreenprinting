---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductCard from '../components/ProductCard.astro';
import Turnaround from '../components/Turnaround.astro';
import VideoGrid from '../components/VideoGrid.astro';
import HeroStudio from '../components/HeroStudio.astro';
import { VIDEOS, videoJsonLd } from '../data/videos';
import { business } from '../data/business';
import { products, featuredProducts } from '../lib/catalog';
import { collectionTiles, brandTiles, styles } from '../components/home/collections';
import {
  ArrowRight, Phone, MapPin, Clock, Shirt, Scissors, Layers, Flame, Stamp, Printer, Maximize, Zap,
  Package, CalendarDays, Store, Trophy, GraduationCap, HeartHandshake, MessageSquareText, Truck, Mic, Sparkles, BadgeCheck,
} from '@lucide/astro';

// Title, description and H1 stay exactly as the live homepage has them (they rank).
const home = await getEntry('pages', 'home');
const title = home?.data.title ?? 'Custom Apparel Printing Los Angeles | TBSP';
const description = home?.data.description ?? '';
const h1 = home?.data.h1 ?? 'Custom apparel printing in Los Angeles';

const services = [
  { href: '/screen-printing/', icon: Shirt, name: 'Screen printing', line: `Thick, punchy color that lasts wash after wash. The best price per piece on bigger runs.` },
  { href: '/services/embroidery/', icon: Scissors, name: 'Embroidery', line: 'Your logo in thread on caps, polos, jackets and uniforms. Made to look premium for years.' },
  { href: '/services/direct-to-film/', icon: Layers, name: 'DTF transfers', line: 'Photo-level detail and full color on cotton, poly and blends.' },
  { href: '/services/direct-to-garment/', icon: Printer, name: 'DTG printing', line: 'Full-color, photo-real prints straight into the fabric.' },
  { href: '/services/heat-transfer-vinyl/', icon: Flame, name: 'Heat transfer', line: 'Names, numbers and sharp edges for jerseys and team gear.' },
  { href: '/services/embossing/', icon: Stamp, name: 'Embossing', line: 'Raised, tonal branding for a quiet-luxury finish.' },
  { href: '/services/large-format-screen-printing/', icon: Maximize, name: 'Oversize prints', line: 'Go big: jumbo prints that cover way more than the chest.' },
  { href: '/same-day-t-shirt-printing-los-angeles/', icon: Zap, name: 'Rush & Super Rush', line: 'Tight deadline? Pick Rush or Super Rush when the date can’t move.' },
];
const audiences = [
  { href: '/for/retail-brands/', icon: Store, name: 'Clothing brands' },
  { href: '/event-apparel/', icon: CalendarDays, name: 'Events & tours' },
  { href: '/small-business/', icon: Package, name: 'Small businesses' },
  { href: '/products/team-uniforms-jerseys/', icon: Trophy, name: 'Teams & leagues' },
  { href: '/for/schools/', icon: GraduationCap, name: 'Schools' },
  { href: '/for/non-profits/', icon: HeartHandshake, name: 'Non-profits' },
];
// Collection tiles: every non-empty collection, linked to its page with a style count.
// Twelve keeps the 2/3/4-column grid even, so the smallest extra collections drop off.
const categories = collectionTiles.length > 12
  ? collectionTiles.filter((c) => [...collectionTiles].sort((a, b) => b.count - a.count).slice(0, 12).includes(c))
  : collectionTiles;
const trust = [
  { icon: BadgeCheck, t: 'Free art check on every order' },
  business.studioLive
    ? { icon: Sparkles, t: 'Max, your merch agent, on call day and night' }
    : { icon: Package, t: `Orders start at ${business.shopMinimum} pieces` },
  { icon: Zap, t: 'Normal, Rush & Super Rush' },
  { icon: MapPin, t: 'Made in Los Angeles & Cleveland' },
];
const brands = brandTiles(10);
const aiPrompts = ['50 black tees with our logo', 'Embroidered hats for my crew', 'Hoodies for a school club', 'Merch for a band tour'];
const steps = [
  { icon: MessageSquareText, name: 'Tell us the idea', line: 'Garment, quantity, deadline and your art. A rough sketch is plenty to start.' },
  { icon: BadgeCheck, name: 'Approve the proof', line: 'We check your art for free, lock in colors and placement, and send the quote.' },
  { icon: Truck, name: 'Grab it or get it shipped', line: 'Made in Los Angeles or Cleveland. Pick it up or we send it your way.' },
];
const faqs = [
  { q: 'Where are you located?', a: `We have two production facilities. Our Los Angeles shop is at ${business.address.streetAddress}, ${business.address.addressLocality}, ${business.address.addressRegion} ${business.address.postalCode}, open Monday to Friday, 9am to 5pm. Our Cleveland facility serves Greater Cleveland and Northeast Ohio with local delivery.` },
  { q: 'What is the minimum order?', a: `Every order starts at ${business.shopMinimum} pieces, for screen printing, embroidery, DTG, DTF and heat transfer alike. Everything is made in our own shops in Los Angeles and Cleveland.` },
  { q: 'How fast can you print?', a: 'Normal delivery arrives in about 2 weeks. Rush arrives in 1 week for an extra 15% of the order cost, and Super Rush arrives in 3 business days for an extra 30%. For Super Rush, order by 2:00 PM ET on Tuesday to have it in hand by Friday. Super Rush is not available for all products, styles or PO Box addresses.' },
  { q: 'How do I get a price?', a: 'Request a quote with your garment, quantity, print locations and artwork. We reply with a personal quote within one business day.' },
];
const bestSellers = featuredProducts.slice(0, 8);
const homeVideos = [VIDEOS.reel, VIDEOS.netflix];
const jsonLd = [...homeVideos.map(videoJsonLd).filter(Boolean) as object[], {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base title={title} description={description} jsonLd={jsonLd} bare>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_80%_20%,rgba(124,58,237,0.16),transparent_70%)] dark:bg-[radial-gradient(60%_60%_at_80%_20%,rgba(139,92,246,0.22),transparent_70%)]" aria-hidden="true"></div>
    <div class="wrap pt-5 sm:pt-20 pb-8 sm:pb-12 md:pb-16 grid gap-7 sm:gap-10 md:gap-12 grid-cols-[minmax(0,1fr)] lg:grid-cols-[1.05fr_0.95fr] items-center">
      <div class="min-w-0">
        <p class="pill"><MapPin class="w-3.5 h-3.5" aria-hidden="true" />Production in Los Angeles &amp; Cleveland</p>
        <h1 class="mt-4 sm:mt-5 text-[2.5rem] sm:text-6xl break-words font-bold leading-[1.02] text-zinc-900 dark:text-white">{h1}</h1>
        <p class="mt-4 sm:mt-6 text-lg leading-8 muted max-w-xl" data-hero-intro>
          Bold ink, clean stitches and merch people actually keep. We print and embroider for brands, tours, crews and teams
          from two production facilities, in Los Angeles and Cleveland: {business.shopMinimum}+ pieces made in-house, with Normal, Rush and Super Rush turnaround.
        </p>
        <form class="mt-5 sm:mt-8 panel-raised p-2 flex items-center gap-2 max-w-xl" action="/quick-quote/" data-hero-ai>
          <span class="w-10 h-10 shrink-0 rounded-xl grid place-items-center bg-violet-600 text-white"><Sparkles class="w-5 h-5" aria-hidden="true" /></span>
          <input name="details" required placeholder="Describe your order: what, how many, by when" aria-label="Describe your order" data-hero-input class="flex-1 min-w-0 h-10 bg-transparent outline-none text-[15px] max-md:text-base text-zinc-900 dark:text-white placeholder:text-zinc-500" />
          <button class="btn-primary btn-sm" type="submit">Start<ArrowRight class="w-4 h-4" aria-hidden="true" /></button>
        </form>
        <div class="mt-3 flex flex-wrap gap-2 m-rail m-rail-auto">
          {aiPrompts.map((p) => <button type="button" class="chip !h-8 max-md:!h-9 !text-[12.5px] max-md:whitespace-nowrap" data-prompt={p}>{p}</button>)}
        </div>
        <div class="mt-4 sm:mt-6 flex flex-wrap gap-3 max-md:grid max-md:grid-cols-2 max-md:gap-2">
          <a class="btn-quiet btn-sm max-md:h-11" href="/catalog/"><Package class="w-4 h-4" aria-hidden="true" />Shop products</a>
          <a class="btn-quiet btn-sm max-md:h-11" href="/quick-quote/">Request a quote</a>
        </div>
        <ul class="mt-5 sm:mt-8 flex flex-wrap gap-x-4 sm:gap-x-6 gap-y-1.5 sm:gap-y-2 text-[12.5px] sm:text-[13px] font-medium muted">
          <li class="flex items-center gap-1.5"><BadgeCheck class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Instant prices, or a quote within 1 business day</li>
          <li class="flex items-center gap-1.5"><Zap class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Rush &amp; Super Rush</li>
          <li class="flex items-center gap-1.5"><Clock class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Free art proof on every order</li>
        </ul>
      </div>

      <HeroStudio />
    </div>
  </section>

  <!-- Trust strip -->
  <section class="wrap mt-4" aria-label="Why TBSP">
    <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-3 gap-y-4 md:gap-6 border-y border-zinc-200/80 dark:border-white/10 py-4 md:py-8">
      {trust.map((t) => (
        <li class="flex flex-col items-center text-center gap-3 max-md:flex-row max-md:text-left max-md:gap-2.5">
          <span class="w-12 h-12 max-md:w-9 max-md:h-9 shrink-0 rounded-full grid place-items-center border border-zinc-300 dark:border-white/20 text-zinc-800 dark:text-zinc-200"><t.icon class="w-6 h-6 max-md:w-[18px] max-md:h-[18px]" aria-hidden="true" /></span>
          <span class="text-[15px] max-md:text-[13px] max-md:leading-snug font-medium text-zinc-800 dark:text-zinc-200">{t.t}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Categories -->
  <section class="wrap mt-20" aria-labelledby="cat-title">
    <h2 id="cat-title" class="text-2xl sm:text-4xl font-bold text-center text-zinc-900 dark:text-white">Custom apparel &amp; merch for your crew</h2>
    <div class="mt-5 md:mt-10 grid gap-2 sm:gap-4 grid-cols-3 md:grid-cols-3 lg:grid-cols-4">
      {categories.map((c) => (
        <a href={c.href} class="group press panel p-3 max-md:p-1.5 max-md:rounded-xl hover:shadow-[0_18px_44px_-24px_rgba(52,33,110,0.45)] hover:border-violet-400/60 transition-all">
          <span class="block aspect-[5/4] max-md:aspect-square rounded-xl max-md:rounded-lg bg-zinc-100 overflow-hidden"><img src={c.img} alt="" loading="lazy" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-105 transition-transform duration-300" /></span>
          <span class="block pt-3 pb-2 max-md:pt-1.5 max-md:pb-1 text-center leading-snug"><span class="block font-semibold max-md:text-[13px] max-md:leading-tight text-zinc-900 dark:text-white">{c.label}</span><span class="block text-[13px] max-md:text-[11.5px] muted">{styles(c.count)}</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Best sellers -->
  <section class="wrap mt-20" aria-labelledby="best-title">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">Best sellers</p>
        <h2 id="best-title" class="section-title mt-2">The blanks our crews order most</h2>
      </div>
      <a href="/catalog/" class="inline-flex items-center gap-1 font-semibold text-zinc-900 dark:text-white hover:text-violet-700 dark:hover:text-violet-300">Shop all {products.length} styles<ArrowRight class="w-4 h-4" aria-hidden="true" /></a>
    </div>
    <ul class="mt-5 md:mt-8 grid grid-cols-4 gap-6 m-rail [--rail-w:44%]">
      {bestSellers.map((p) => <li class="snap-start"><ProductCard p={p} /></li>)}
    </ul>
  </section>

  <!-- Max, the merch agent: what makes TBSP different -->
  {business.maxLive && <section class="wrap mt-20 scroll-mt-40" id="max" data-max-only>
    <div class="grid lg:grid-cols-2 rounded-3xl overflow-hidden border border-zinc-200/80 dark:border-white/10">
      <div class="relative bg-zinc-100 dark:bg-white/[0.04] p-8 sm:p-10 grid gap-3 content-center">
        {[
          { who: 'you', t: 'I need 36 hoodies for our crew, logo on the chest, by the 15th.' },
          { who: 'ai', t: 'Got it. Black heavyweight hoodie, your logo on the chest, with a size split for 36 people. Here is your order with the real price, ready by the 12th.' },
          { who: 'you', t: 'Add our name on the back.' },
          { who: 'ai', t: 'Done, back print added and the price updated. Tap Order & pay, or I can send it to our team as a quote.' },
        ].map((m) => (
          <p class:list={['max-w-[85%] rounded-2xl px-4 py-2.5 text-[14px] leading-6', m.who === 'you' ? 'justify-self-end bg-violet-600 text-white rounded-br-md' : 'bg-white dark:bg-[#0d0d14] text-zinc-800 dark:text-zinc-200 border border-zinc-200/80 dark:border-white/10 rounded-bl-md']}>{m.t}</p>
        ))}
      </div>
      <div class="bg-violet-600 text-white p-8 sm:p-12 grid content-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-violet-200">What makes TBSP different</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Max, your merch agent, does the work for you</h2>
        <p class="mt-4 text-violet-100 leading-7">Tell Max what you need. He picks the product and print method, checks your logo, splits the sizes, plans your deadline and builds a priced order you can pay for in one tap. Real people print it, and you approve a proof first.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/quick-quote/" data-ask-ai class="btn bg-white text-violet-700 hover:bg-violet-50"><Sparkles class="w-4 h-4" aria-hidden="true" />Ask Max</a>
          <a href="/custom-projects/" class="btn border border-white/30 text-white hover:bg-white/10">See custom projects</a>
        </div>
      </div>
    </div>
  </section>}

  <!-- Services -->
  <section class="wrap mt-24" aria-labelledby="services-title">
    <p class="eyebrow">What we print</p>
    <h2 id="services-title" class="section-title mt-2">Ink, thread and everything in between</h2>
    <div class="mt-5 md:mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 m-rail [--rail-w:66%]">
      {services.map((s) => (
        <a class="tile max-md:p-4" href={s.href}>
          <span class="tile-icon"><s.icon class="w-5 h-5" aria-hidden="true" /></span>
          <strong class="mt-2 max-md:mt-1 text-zinc-900 dark:text-white">{s.name}</strong>
          <span class="text-sm muted">{s.line}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Custom projects -->
  <section class="wrap mt-4 md:mt-6">
    <a href="/custom-projects/" class="press panel-raised p-4 sm:p-7 flex flex-wrap items-center justify-between gap-3 md:gap-5 hover:border-violet-400/60 transition-colors">
      <div class="flex items-start gap-4">
        <span class="tile-icon shrink-0"><Sparkles class="w-5 h-5" aria-hidden="true" /></span>
        <div>
          <p class="font-bold text-zinc-900 dark:text-white">Something the catalog can't do?</p>
          <p class="mt-1 text-sm muted">Custom cut &amp; sew, sublimation, all-over prints and embossing on tees, hoodies, hats and more. Request it with a quote{business.studioLive ? ' or ask Max' : ''}.</p>
        </div>
      </div>
      <span class="btn-quiet btn-sm max-md:w-full max-md:h-11">Start a custom project<ArrowRight class="w-4 h-4" aria-hidden="true" /></span>
    </a>
  </section>

  <!-- How it works -->
  <section class="wrap mt-24" aria-labelledby="how-title">
    <p class="eyebrow">How it works</p>
    <h2 id="how-title" class="section-title mt-2">From napkin sketch to boxed and ready</h2>
    <ol class="mt-5 md:mt-8 grid gap-2 md:gap-4 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="panel p-6 max-md:p-4 max-md:flex max-md:items-start max-md:gap-3">
          <div class="flex items-center gap-3 shrink-0">
            <span class="w-8 h-8 rounded-full grid place-items-center bg-violet-600 text-white text-sm font-bold">{i + 1}</span>
            <s.icon class="w-5 h-5 text-violet-600 dark:text-violet-300 max-md:hidden" aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <p class="mt-4 max-md:mt-0.5 font-bold text-zinc-900 dark:text-white">{s.name}</p>
            <p class="mt-1.5 max-md:mt-1 text-sm muted">{s.line}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Brands -->
  <section class="wrap mt-24" aria-labelledby="brands-title">
    <h2 id="brands-title" class="text-2xl md:text-3xl font-bold text-center text-zinc-900 dark:text-white">Brands we print on</h2>
    <p class="mt-2 text-center muted">Shop by brand: the names your crew already knows.</p>
    <ul class="mt-5 md:mt-8 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 m-rail m-rail-auto">
      {brands.map((b) => (
        <li><a href={b.href} class="press h-20 max-md:h-14 max-md:px-4 max-md:rounded-xl rounded-2xl bg-zinc-100 dark:bg-white/[0.05] border border-transparent hover:border-violet-400/60 hover:bg-white dark:hover:bg-white/[0.08] transition-colors flex flex-col items-center justify-center px-2 text-center">
          <span class="font-display font-extrabold tracking-tight leading-tight max-md:whitespace-nowrap max-md:text-[15px] text-zinc-800 dark:text-zinc-100">{b.name}</span>
          <span class="mt-0.5 text-[12px] muted">{styles(b.count)}</span>
        </a></li>
      ))}
    </ul>
    <p class="mt-3 md:mt-5 text-center"><a href="/catalog/" class="max-md:min-h-[44px] inline-flex items-center gap-1 font-semibold text-zinc-900 dark:text-white hover:text-violet-700 dark:hover:text-violet-300">Browse the catalog<ArrowRight class="w-4 h-4" aria-hidden="true" /></a></p>
  </section>

  <!-- Videos -->
  <section class="wrap mt-24"><VideoGrid videos={homeVideos} eyebrow="Inside the shop" title="Watch us print" /></section>

  <!-- Turnaround -->
  <section class="wrap mt-24" aria-labelledby="turn-title">
    <p class="eyebrow">Turnaround</p>
    <h2 id="turn-title" class="section-title mt-2">Your deadline, your speed</h2>
    <p class="mt-2 md:mt-3 max-md:text-[14px] muted max-w-2xl">Pick the turnaround that fits your date. Every option gets the same free art check and the same quality.</p>
    <div class="mt-5 md:mt-8"><Turnaround /></div>
  </section>

  <!-- Audiences -->
  <section class="wrap mt-24" aria-labelledby="who-title">
    <p class="eyebrow">Who we print for</p>
    <h2 id="who-title" class="section-title mt-2">Made for people who wear their name</h2>
    <div class="mt-5 md:mt-8 grid gap-3 grid-cols-2 md:grid-cols-3 m-rail m-rail-auto">
      {audiences.map((a) => (
        <a class="tile !flex-row !items-center !gap-3 !py-4 max-md:!gap-2 max-md:!py-1.5 max-md:!pl-1.5 max-md:!pr-4 max-md:!rounded-full max-md:hover:!translate-y-0" href={a.href}>
          <span class="tile-icon max-md:w-8 max-md:h-8 max-md:rounded-full"><a.icon class="w-5 h-5" aria-hidden="true" /></span>
          <strong class="text-zinc-900 dark:text-white text-[15px] max-md:text-[14px] max-md:whitespace-nowrap">{a.name}</strong>
        </a>
      ))}
    </div>
  </section>

  <!-- Locations -->
  <section class="wrap mt-24" aria-labelledby="where-title">
    <p class="eyebrow">Where we make it</p>
    <h2 id="where-title" class="section-title mt-2">Two production facilities, one standard</h2>
    <div class="mt-5 md:mt-8 grid gap-3 md:gap-4 md:grid-cols-2">
      <a href="/los-angeles-ca/" class="tile !p-6 max-md:!p-4">
        <span class="tile-icon"><MapPin class="w-5 h-5" aria-hidden="true" /></span>
        <strong class="mt-2 max-md:mt-1 text-lg max-md:text-base text-zinc-900 dark:text-white">Los Angeles, California</strong>
        <span class="text-sm muted">{business.address.streetAddress}, {business.address.addressLocality}. Monday–Friday, 9am–5pm. Pickup, rush and delivery across LA.</span>
        <span class="mt-2 max-md:mt-1 inline-flex items-center gap-1 text-sm font-semibold text-violet-700 dark:text-violet-300">Los Angeles printing<ArrowRight class="w-4 h-4" aria-hidden="true" /></span>
      </a>
      <a href="/cleveland-oh/" class="tile !p-6 max-md:!p-4">
        <span class="tile-icon"><MapPin class="w-5 h-5" aria-hidden="true" /></span>
        <strong class="mt-2 max-md:mt-1 text-lg max-md:text-base text-zinc-900 dark:text-white">Cleveland, Ohio</strong>
        <span class="text-sm muted">Serving Greater Cleveland and Northeast Ohio with local production and delivery.</span>
        <span class="mt-2 max-md:mt-1 inline-flex items-center gap-1 text-sm font-semibold text-violet-700 dark:text-violet-300">Cleveland printing<ArrowRight class="w-4 h-4" aria-hidden="true" /></span>
      </a>
    </div>
  </section>

  <section class="wrap mt-24"><Faq faqs={faqs} /></section>
  <section class="wrap mt-24"><CtaBand /></section>
</Base>

<script>
  const heroForm = document.querySelector<HTMLFormElement>('[data-hero-ai]');
  if (heroForm) {
    const input = heroForm.querySelector('input')!;
    // With Max on, a suggestion starts the conversation right away; otherwise it fills the box.
    const maxOn = () => document.documentElement.dataset.max === 'on' && !!document.querySelector('[data-max-sheet]');
    document.querySelectorAll<HTMLButtonElement>('[data-prompt]').forEach((b) => b.addEventListener('click', () => {
      if (maxOn()) { window.dispatchEvent(new CustomEvent('tbsp-max-ask', { detail: b.dataset.prompt })); return; }
      input.value = b.dataset.prompt!; input.focus();
    }));
    // The box speaks for Max once he's on.
    const setPlaceholder = () => { if (maxOn()) input.placeholder = 'Tell Max what you need…'; };
    setPlaceholder(); new MutationObserver(setPlaceholder).observe(document.documentElement, { attributes: true, attributeFilter: ['data-max'] });
    heroForm.addEventListener('submit', (e) => {
      // Max takes it from here (he falls back to the quote form if the shop can't be reached).
      if (maxOn()) { e.preventDefault(); window.dispatchEvent(new CustomEvent('tbsp-max-ask', { detail: input.value })); input.value = ''; }
    });
  }
</script>
