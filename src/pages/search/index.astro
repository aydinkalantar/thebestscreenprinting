---
// Search results: /search/?q=pink. The header search box sends Enter here.
// The grid, filters and the reading of the query live in ProductBrowser + src/lib/search.ts.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductBrowser from '../../components/catalog/ProductBrowser.astro';
import { products } from '../../lib/catalog';
---
<Base title="Search | TBSP" description="Search our products by color, brand, style number, product type or fabric." noindex>
  <Breadcrumbs items={[{ label: 'Search' }]} />
  <h1 data-search-title class="mt-2 text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white break-words">Search</h1>
  <p data-search-sub class="mt-2 text-[15px] muted empty:hidden"></p>
  <div data-search-understood hidden class="mt-4 flex flex-wrap items-center gap-2"></div>

  <ProductBrowser products={products} search />

  <section class="mt-16 panel p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex-1">
      <p class="text-lg font-bold text-zinc-900 dark:text-white">Not seeing what you need?</p>
      <p class="mt-1 text-sm muted">We print on almost anything, including brands we don't list and items you bring us.</p>
    </div>
    <button type="button" data-max-open data-max-only class="btn-primary">Ask Max</button>
    <a href="/quick-quote/" class="btn-quiet">Request a quote</a>
  </section>
</Base>
