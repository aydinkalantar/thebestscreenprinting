---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { products, CATEGORY_LABELS } from '../../lib/catalog';
import { business } from '../../data/business';

const categories = [...new Set(products.map((p) => p.category))]
  .map((c) => ({ id: c, label: CATEGORY_LABELS[c] || c, count: products.filter((p) => p.category === c).length }))
  .sort((a, b) => b.count - a.count);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${business.url}/catalog/${p.slug}/`, name: p.name })),
}];
---
<Base title="Custom Apparel & Merch Catalog | TBSP Los Angeles" description={`Browse ${products.length} products you can customize with your logo: tees, hoodies, hats, bags and more. Orders start at ${business.shopMinimum} pieces, made in our own shops.`} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Catalog' }]} />
  <p class="eyebrow">Catalog</p>
  <h1 class="mt-3 text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-white">Products for your design</h1>
  <p class="mt-4 text-lg muted max-w-2xl">
    {products.length} products, from tees to totes. Every order is made in our own shops in Los Angeles and Cleveland, starting at {business.shopMinimum} pieces{business.studioLive ? ', and you can design it online' : ''}.
  </p>

  <div class="mt-8 -mx-4 px-4 flex gap-2 overflow-x-auto no-scrollbar" role="group" aria-label="Filter by category">
    <button type="button" class="chip is-on shrink-0" data-cat="">All <span class="muted font-medium">{products.length}</span></button>
    {categories.map((c) => <button type="button" class="chip shrink-0" data-cat={c.id}>{c.label} <span class="muted font-medium">{c.count}</span></button>)}
  </div>

  <ul class="mt-8 grid gap-x-5 gap-y-8 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    {products.map((p) => <li data-cat={p.category} data-sub={p.subcategory ?? ""}><ProductCard p={p} /></li>)}
  </ul>

  <div class="mt-20"><CtaBand title="Don't see it?" text="We print on almost anything: your own garments, brands we don't list, special finishes. Tell us what you have in mind." /></div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-cat].chip');
  const items = document.querySelectorAll<HTMLElement>('li[data-cat]');
  const apply = (cat: string, sub = '') => {
    chips.forEach((c) => c.classList.toggle('is-on', c.dataset.cat === (sub ? '' : cat)));
    items.forEach((li) => { li.hidden = sub ? li.dataset.sub !== sub : !!cat && li.dataset.cat !== cat; });
  };
  chips.forEach((chip) => chip.addEventListener('click', () => {
    history.replaceState(null, '', chip.dataset.cat ? `?cat=${chip.dataset.cat}` : location.pathname);
    apply(chip.dataset.cat || '');
  }));
  // Menu links land here with ?cat= or ?sub= already chosen.
  const params = new URLSearchParams(location.search);
  if (params.get('cat') || params.get('sub')) apply(params.get('cat') || '', params.get('sub') || '');
</script>
