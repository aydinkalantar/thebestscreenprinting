---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import CollectionChips from '../../components/catalog/CollectionChips.astro';
import ProductBrowser from '../../components/catalog/ProductBrowser.astro';
import { products, COLLECTIONS, collectionHref, collectionProducts } from '../../lib/catalog';
import { business } from '../../data/business';

// Old links (/catalog/?sub=dad-hats, ?cat=kids) go to the matching collection page.
const live = new Set(COLLECTIONS.filter((c) => collectionProducts(c.slug).length).map((c) => c.slug));
const pick = (m: Record<string, string>) => Object.fromEntries(Object.entries(m).filter(([, v]) => live.has(v)).map(([k, v]) => [k, collectionHref(v)]));
const legacy = {
  sub: pick({
    't-shirts': 't-shirts', 'long-sleeves': 'long-sleeves', hoodies: 'hoodies', 'zip-hoodies': 'hoodies', crewnecks: 'crewnecks',
    polos: 'polos', 'dad-hats': 'hats', 'trucker-hats': 'hats', snapbacks: 'hats', 'fitted-hats': 'hats', beanies: 'beanies',
    'tank-tops': 'tank-tops', 'crop-tops': 'tank-tops', sweatpants: 'sweatpants-shorts', shorts: 'sweatpants-shorts',
    jackets: 'jackets', totes: 'bags',
  }),
  cat: pick({ kids: 'kids', womens: 'womens', hats: 'hats', accessories: 'bags', pants: 'sweatpants-shorts', outerwear: 'jackets' }),
};
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${business.url}/catalog/${p.slug}/`, name: p.name })),
}];
---
<Base title="Custom Apparel & Merch Catalog | TBSP Los Angeles" description={`Browse ${products.length} products you can customize with your logo: tees, hoodies, hats, bags and more. Orders start at ${business.shopMinimum} pieces, made in our own shops.`} jsonLd={jsonLd}>
  <script is:inline define:vars={{ legacy }}>
    (() => {
      const q = new URLSearchParams(location.search);
      const sub = q.get('sub'), cat = q.get('cat');
      const to = (sub && legacy.sub[sub]) || (!sub && cat && legacy.cat[cat]) || (sub && cat && legacy.cat[cat]);
      if (to) location.replace(to);
    })();
  </script>
  <Breadcrumbs items={[{ label: 'Catalog' }]} />
  <p class="eyebrow">Catalog</p>
  <h1 class="mt-3 text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-white">Products for your design</h1>
  <p class="mt-4 text-lg muted max-w-2xl">
    {products.length} products, from tees to totes. Every order is made in our own shops in Los Angeles and Cleveland, starting at {business.shopMinimum} pieces{business.studioLive ? ', and you can design it online' : ''}.
  </p>

  <CollectionChips />
  <ProductBrowser products={products} />

  <div class="mt-20"><CtaBand title="Don't see it?" text="We print on almost anything: your own garments, brands we don't list, special finishes. Tell us what you have in mind." /></div>
</Base>
