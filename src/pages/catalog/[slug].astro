---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, CATEGORY_LABELS, techniqueNames, customizeHref, type CatalogProduct } from '../../lib/catalog';
import { business } from '../../data/business';
import { ArrowRight, Palette, Phone, Check, Users, Sparkles } from '@lucide/astro';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: CatalogProduct };
const methods = techniqueNames(p.techniques);
const category = CATEGORY_LABELS[p.category] || p.category;
const related = products.filter((x) => x.category === p.category && x.id !== p.id).slice(0, 4);
const description = `Custom ${p.name} printed with your logo or design. ${methods.join(', ')}. Orders from ${business.shopMinimum} pieces, made in our own shops in Los Angeles and Cleveland.`;
const url = `${business.url}/catalog/${p.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    image: p.images.length ? p.images : [p.image],
    description,
    ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
    ...(p.style ? { mpn: p.style } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${business.url}/catalog/` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---
<Base title={`Custom ${p.name} | TBSP Los Angeles`} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Catalog', href: '/catalog/' }, { label: category, href: `/catalog/` }, { label: p.name }]} />
  <div class="grid gap-10 lg:grid-cols-2">
    <div class="relative">
      <div class="absolute inset-8 rounded-[2rem] bg-violet-500/15 blur-3xl" aria-hidden="true"></div>
      <img id="main-img" src={p.colors[0]?.image || p.image} alt={p.name} width="640" height="640" class="relative w-full aspect-square object-contain panel-raised p-4 bg-zinc-50 dark:bg-white/[0.04]" />
    </div>
    <div>
      <p class="eyebrow">{category}</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white">{p.name}</h1>
      <p class="mt-4 text-[15px] muted">Priced per order with your decoration included. Send your quantity and artwork for a quote within one business day. Orders start at {business.shopMinimum} pieces.</p>

      {p.colors.length > 0 && (
        <section class="mt-7">
          <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Color · <span id="color-name" class="normal-case tracking-normal text-zinc-900 dark:text-white text-[13px]">{p.colors[0].name}</span></p>
          <div class="mt-3 flex flex-wrap gap-2">
            {p.colors.map((c, i) => (
              <button type="button" class:list={['swatch w-8 h-8 rounded-full border border-zinc-300 dark:border-white/20 transition-shadow', { 'is-on ring-2 ring-violet-500 ring-offset-2 ring-offset-white dark:ring-offset-[#0a0a0f]': i === 0 }]} style={`background:${c.hex}`} title={c.name} aria-label={c.name} data-name={c.name} data-img={c.image || ''}></button>
            ))}
          </div>
        </section>
      )}
      {p.sizes.length > 0 && (
        <section class="mt-6">
          <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Sizes</p>
          <div class="mt-3 flex flex-wrap gap-2">{p.sizes.map((s) => <span class="chip !h-8 !cursor-default">{s}</span>)}</div>
        </section>
      )}
      <section class="mt-6">
        <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Decoration</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">{methods.map((m) => <li class="flex items-center gap-1.5"><Check class="w-4 h-4 text-emerald-500" aria-hidden="true" />{m}</li>)}</ul>
      </section>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={customizeHref(p)} rel={business.studioLive ? 'nofollow' : undefined}>
          {business.studioLive ? <><Palette class="w-4 h-4" aria-hidden="true" />Customize in TBSP Studio</> : <>Get a quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></>}
        </a>
        <a class="btn-quiet" href={`tel:${business.phone}`}><Phone class="w-4 h-4" aria-hidden="true" />{business.phoneDisplay}</a>
      </div>

      {p.features?.length > 0 && (
        <section class="mt-8">
          <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Details</p>
          <ul class="mt-3 grid gap-1.5 text-sm muted list-disc pl-5">{p.features.map((f) => <li>{f}</li>)}</ul>
        </section>
      )}

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {!business.studioLive && (
          <div class="panel p-4 flex gap-3"><Sparkles class="w-5 h-5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><p class="text-[13px] muted">Online design is coming soon. Until then, send your artwork with a quote request.</p></div>
        )}
        <div class="panel p-4 flex gap-3"><Users class="w-5 h-5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><p class="text-[13px] muted">Orders start at {business.shopMinimum} pieces. Bigger runs bring the price per piece down.</p></div>
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section class="mt-20">
      <p class="eyebrow">More {category.toLowerCase()}</p>
      <div class="mt-6 grid gap-5 grid-cols-2 md:grid-cols-4">{related.map((r) => <ProductCard p={r} />)}</div>
    </section>
  )}
</Base>

<script>
  const main = document.getElementById('main-img') as HTMLImageElement | null;
  const label = document.getElementById('color-name');
  const on = ['is-on', 'ring-2', 'ring-violet-500', 'ring-offset-2'];
  document.querySelectorAll<HTMLButtonElement>('.swatch').forEach((b, _, all) => b.addEventListener('click', () => {
    all.forEach((x) => on.forEach((c) => x.classList.toggle(c, x === b)));
    if (label) label.textContent = b.dataset.name || '';
    if (main && b.dataset.img) main.src = b.dataset.img;
  }));
</script>
