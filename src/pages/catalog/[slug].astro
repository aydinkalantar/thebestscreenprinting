---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, CATEGORY_LABELS, COLLECTIONS, collectionHref, brandHref, techniqueNames, customizeHref, type CatalogProduct } from '../../lib/catalog';
import { business } from '../../data/business';
import DesignPreview from '../../components/design/DesignPreview.astro';
import DesignRequestSheet from '../../components/design/DesignRequestSheet.astro';
import OrderSheet from '../../components/design/OrderSheet.astro';
import { ArrowRight, Palette, Phone, Check, Users, Sparkles, Send, ClipboardPlus, CircleCheck, X, Upload, CreditCard, ShoppingBag } from '@lucide/astro';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: CatalogProduct };
const methods = techniqueNames(p.techniques);
const collection = COLLECTIONS.find((c) => c.match(p));
const category = collection?.label ?? (CATEGORY_LABELS[p.category] || p.category);
const categoryHref = collection ? collectionHref(collection.slug) : '/catalog/';
const sameGroup = (x: CatalogProduct) => (collection ? collection.match(x) : x.category === p.category);
const related = products.filter((x) => x.id !== p.id && sameGroup(x)).slice(0, 4);
const locations = p.category === 'hats' ? ['Front', 'Back', 'Side'] : p.category === 'accessories' ? ['Front', 'Back'] : ['Front', 'Back', 'Left chest', 'Sleeve'];
const min = business.shopMinimum;
const SWATCH_LIMIT = 24;
const description = `Custom ${p.name} printed with your logo or design. ${methods.join(', ')}. Orders from ${min} pieces, made in our own shops in Los Angeles and Cleveland.`;
const url = `${business.url}/catalog/${p.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    image: p.images.length ? p.images : [p.image],
    description,
    ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
    ...(p.style ? { mpn: p.style } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${business.url}/catalog/` },
      { '@type': 'ListItem', position: 3, name: category, item: `${business.url}${categoryHref}` },
      { '@type': 'ListItem', position: 4, name: p.name, item: url },
    ],
  },
];
const step = 'inline-grid place-items-center w-5 h-5 mr-2 rounded-full bg-violet-600 text-white text-[11px] font-bold tracking-normal align-[1px]';
const chipOn = 'chip cursor-pointer select-none has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 has-[:checked]:text-violet-700 dark:has-[:checked]:text-violet-300';
---
<Base title={`Custom ${p.name} | TBSP Los Angeles`} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Catalog', href: '/catalog/' }, { label: category, href: categoryHref }, { label: p.name }]} />
  <div class="grid gap-4 md:gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <div class="min-w-0 lg:order-none">
      <DesignPreview p={p} />
    </div>
    <div class="min-w-0">
      <p class="eyebrow"><a href={categoryHref} class="hover:underline">{category}</a></p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white">{p.name}</h1>
      {p.brand && (
        <p class="mt-2 text-[14px] muted">
          <a href={brandHref(p.brand)} class="font-semibold text-zinc-700 dark:text-zinc-300 hover:text-violet-700 dark:hover:text-violet-300 underline-offset-2 hover:underline">{p.brand}</a>{p.style && <> · Style {p.style}</>}
        </p>
      )}
      <p class="mt-4 text-[15px] muted">Priced per order with your decoration included. Pick a color and sizes, and we'll send a quote within one business day. Orders start at {min} pieces.</p>

      <form id="add-to-quote" class="mt-7 panel-raised p-5 sm:p-6 grid grid-cols-[minmax(0,1fr)] gap-6 min-w-0" novalidate
        data-id={p.id} data-slug={p.slug} data-name={p.name} data-style={p.style ?? ''} data-brand={p.brand ?? ''} data-cat={p.category} data-sub={p.subcategory ?? ''} data-img={p.image} data-min={min}>
        <p class="text-lg font-bold text-zinc-900 dark:text-white -mb-2">Customize &amp; order</p>
        {p.colors.length > 0 && (
          <fieldset>
            <legend class="eyebrow !text-zinc-500 dark:!text-zinc-400"><span class={step}>1</span>Color · <span id="color-name" class="normal-case tracking-normal text-zinc-900 dark:text-white text-[13px]">{p.colors[0].name}</span></legend>
            <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-label="Color">
              {p.colors.map((c, i) => (
                <button type="button" role="radio" hidden={i >= SWATCH_LIMIT} aria-checked={i === 0 ? 'true' : 'false'} class:list={['swatch w-8 h-8 max-md:w-10 max-md:h-10 rounded-full border border-zinc-300 dark:border-white/20 transition-shadow', { 'is-on ring-2 ring-violet-500 ring-offset-2 ring-offset-white dark:ring-offset-[#0d0d14]': i === 0 }]} style={`background:${c.hex}`} title={c.name} aria-label={c.name} data-name={c.name} data-img={c.image || ''} data-back={c.back || ''}></button>
              ))}
            </div>
            {p.colors.length > SWATCH_LIMIT && (
              <button type="button" id="more-colors" class="mt-3 text-[13px] font-semibold text-violet-700 dark:text-violet-300 hover:underline">Show all {p.colors.length} colors</button>
            )}
          </fieldset>
        )}

        <fieldset>
          <legend class="eyebrow !text-zinc-500 dark:!text-zinc-400"><span class={step}>{p.colors.length > 0 ? 2 : 1}</span>Quantity by size</legend>
          <div class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-2.5">
            {p.sizes.map((s) => (
              <label class="grid gap-1 text-center">
                <span class="text-[12px] font-semibold text-zinc-600 dark:text-zinc-300">{s}</span>
                <input type="number" inputmode="numeric" pattern="[0-9]*" enterkeyhint="next" min="0" max="99999" step="1" placeholder="0" class="field !h-10 !px-2 text-center max-md:!h-12" data-size={s} aria-label={`Quantity, size ${s}`} />
              </label>
            ))}
          </div>
          <p class="mt-3 flex flex-wrap items-baseline justify-between gap-2 text-[13px]">
            <span class="font-semibold text-zinc-900 dark:text-white">Total: <span id="qty-total">0</span> pieces</span>
            <span class="muted">Minimum {min} pieces per product</span>
          </p>
        </fieldset>

        <!-- Step 3: artwork. The list is filled by the design preview. -->
        <div data-design-summary class="grid grid-cols-[minmax(0,1fr)] gap-2 min-w-0">
          <div class="flex items-baseline justify-between gap-3">
            <p class="eyebrow !text-zinc-500 dark:!text-zinc-400"><span class={step}>3</span>Your artwork <span class="normal-case tracking-normal font-medium">(optional)</span></p>
            <a href="#design" data-art-some hidden class="text-[13px] font-semibold text-violet-700 dark:text-violet-300 hover:underline">Add more</a>
          </div>
          <div data-art-none class="flex flex-wrap items-center gap-3 rounded-xl border border-dashed border-zinc-300 dark:border-white/15 px-4 py-3">
            <p class="min-w-0 flex-1 text-[13px] muted">Upload your logo to see it on the product. No file yet? Skip this, you can send it later.</p>
            <button type="button" data-art-upload class="btn-quiet btn-sm max-md:h-11 max-sm:w-full"><Upload class="w-4 h-4" aria-hidden="true" />Upload artwork</button>
          </div>
          <ul data-list data-art-some hidden class="divide-y divide-zinc-200/80 dark:divide-white/10"></ul>
          <p data-bytes data-art-some hidden class="text-[12px] muted"></p>
        </div>

        {methods.length > 0 && (
          <fieldset data-plain-only>
            <legend class="eyebrow !text-zinc-500 dark:!text-zinc-400">Decoration</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {methods.map((m) => <label class={chipOn}><input type="checkbox" name="decoration" value={m} checked={methods.length === 1} class="accent-violet-600" />{m}</label>)}
            </div>
          </fieldset>
        )}

        <fieldset data-plain-only>
          <legend class="eyebrow !text-zinc-500 dark:!text-zinc-400">Print location</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {locations.map((l, i) => <label class={chipOn}><input type="checkbox" name="location" value={l} checked={i === 0} class="accent-violet-600" />{l}</label>)}
          </div>
        </fieldset>

        <!-- Step 4: instant price + "Order & pay". Hidden unless online orders are on in the studio admin. -->
        <section data-instant hidden class="grid gap-3 rounded-2xl border border-violet-300/60 dark:border-violet-400/25 bg-violet-500/[0.05] p-4" aria-labelledby="ip-title">
          <div class="flex items-baseline justify-between gap-3">
            <p id="ip-title" class="eyebrow !text-zinc-500 dark:!text-zinc-400"><span class={step}>4</span>Your price</p>
            <span data-ip-status class="text-[12px] muted" aria-live="polite"></span>
          </div>
          <div data-ip-inks class="grid gap-2"></div>
          <!-- Paid artwork help (shown when the studio offers it). -->
          <div data-ip-art hidden class="grid gap-2 rounded-xl border border-dashed border-zinc-300 dark:border-white/15 p-3">
            <div data-art-suggest hidden class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-violet-500/10 px-3 py-2 text-[13px] text-violet-800 dark:text-violet-200">
              <span data-art-suggest-text></span>
              <button type="button" data-art-suggest-btn class="font-semibold underline underline-offset-2"></button>
            </div>
            <label class="flex items-center gap-2.5 text-[14px] font-semibold text-zinc-900 dark:text-white cursor-pointer"><input type="checkbox" data-art-on class="w-4 h-4 accent-violet-600" />Need help with your artwork?</label>
            <div data-art-opts hidden class="grid gap-2">
              {(['cleanup', 'layout', 'custom'] as const).map((k, i) => (
                <label class="flex items-start gap-2.5 rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.03] px-3 py-2 cursor-pointer has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10" data-art-opt={k}>
                  <input type="radio" name="artHelp" value={k} checked={i === 0} class="mt-1 accent-violet-600" />
                  <span class="min-w-0 flex-1 text-[13.5px] leading-snug">
                    <span class="flex justify-between gap-2"><span class="font-semibold text-zinc-900 dark:text-white">{ { cleanup: 'Art cleanup / vectorize', layout: 'Text or simple layout', custom: 'Custom design' }[k] }</span><span class="font-semibold text-zinc-900 dark:text-white" data-art-price={k}></span></span>
                    <span class="block text-[12.5px] muted">{ { cleanup: 'Make a blurry or low-res logo sharp and print-ready.', layout: 'Names, team text, or arranging logos you already have.', custom: 'A new design from your idea. We confirm the final price before starting.' }[k] }</span>
                  </span>
                </label>
              ))}
              <textarea data-art-notes rows="2" maxlength="1000" class="field !h-auto py-2 text-[14px]" placeholder="Tell us what you need, e.g. clean up our logo and add “Staff” under it"></textarea>
              <p data-art-terms class="text-[12px] muted"></p>
            </div>
          </div>
          <div data-ip-body hidden class="grid gap-1.5">
            <p class="flex items-baseline gap-2 flex-wrap"><span data-ip-each class="text-[26px] leading-none font-bold text-zinc-900 dark:text-white"></span><span class="text-[14px] muted">per piece</span></p>
            <p data-ip-sizes class="text-[12.5px] muted"></p>
            <dl data-ip-lines class="mt-1 grid grid-cols-[1fr_auto] gap-y-1 text-[14px]"></dl>
            <p data-ip-next hidden class="mt-1 text-[13px] font-medium text-emerald-700 dark:text-emerald-400"></p>
            <p data-ip-stock hidden class="text-[13px] font-medium text-amber-700 dark:text-amber-300"></p>
          </div>
          <p data-ip-quote hidden class="text-[13px] muted"></p>
          <button type="button" data-ip-order hidden class="btn-primary w-full h-12 text-[15px] disabled:opacity-50 disabled:shadow-none"><CreditCard class="w-4 h-4" aria-hidden="true" /><span>Order &amp; pay now</span></button>
          <p data-ip-foot hidden class="text-[12px] muted">Tax is added at checkout. Free art proof before we print.</p>
        </section>

        <div class="grid gap-2">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <button id="request-quote" type="submit" class="btn-primary w-full sm:w-auto disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none aria-busy:cursor-wait" disabled>
              <ShoppingBag class="w-4 h-4" aria-hidden="true" /><span>Add to cart</span>
            </button>
            <button id="request-single" type="button" class="text-[13.5px] font-semibold text-violet-700 dark:text-violet-300 hover:underline underline-offset-2 disabled:opacity-50 disabled:no-underline disabled:cursor-not-allowed max-sm:w-full max-sm:min-h-[44px]" disabled>
              Request a quote for just this item
            </button>
          </div>
          <p id="qty-hint" class="text-[13px] muted" aria-live="polite">Enter at least {min} pieces to add this product to your cart.</p>
          <p id="cart-error" class="err" role="alert"></p>
          <p class="text-[12.5px] muted">Ordering several products? Add each one to your cart, then check out or request one quote for all of them. Minimum {min} pieces per product.</p>
        </div>
      </form>

      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn-quiet" href={customizeHref(p)} rel={business.studioLive ? 'nofollow' : undefined}>
          {business.studioLive ? <><Palette class="w-4 h-4" aria-hidden="true" />Customize in TBSP Studio</> : <>Not sure yet? Get a quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></>}
        </a>
        <a class="btn-quiet" href={`tel:${business.phone}`}><Phone class="w-4 h-4" aria-hidden="true" />{business.phoneDisplay}</a>
      </div>

      <section class="mt-8">
        <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Available decoration</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">{methods.map((m) => <li class="flex items-center gap-1.5"><Check class="w-4 h-4 text-emerald-500" aria-hidden="true" />{m}</li>)}</ul>
      </section>

      {p.features?.length > 0 && (
        <section class="mt-8">
          <p class="eyebrow !text-zinc-500 dark:!text-zinc-400">Details</p>
          <ul class="mt-3 grid gap-1.5 text-sm muted list-disc pl-5">{p.features.map((f) => <li>{f}</li>)}</ul>
        </section>
      )}

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        {!business.studioLive && (
          <div class="panel p-4 flex gap-3"><Sparkles class="w-5 h-5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><p class="text-[13px] muted">Online design is coming soon. Until then, send your artwork with a quote request.</p></div>
        )}
        <div class="panel p-4 flex gap-3"><Users class="w-5 h-5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><p class="text-[13px] muted">Orders start at {min} pieces. Bigger runs bring the price per piece down.</p></div>
      </div>
    </div>
  </div>

  <!-- Phones: sticky action bar (replaces the tab bar on this page). It drives the
       "Add to cart" form above, so the minimum and the quote link stay in one place. -->
  <div data-pdp-bar class="md:hidden fixed inset-x-0 bottom-0 z-[60] border-t border-zinc-200/80 dark:border-white/10 bg-white/90 dark:bg-[#0a0a0f]/90 backdrop-blur-xl backdrop-saturate-150 pb-[env(safe-area-inset-bottom)]">
    <div class="px-4 h-[76px] flex items-center gap-2.5">
      <button type="button" data-max-open aria-haspopup="dialog" aria-label="Ask Max about this product" class="press max-orb relative w-11 h-11 shrink-0"><Sparkles class="w-5 h-5" aria-hidden="true" /></button>
      <button type="button" data-bar-sizes class="press min-w-0 flex-1 flex items-center gap-2.5 text-left" aria-label="Choose sizes and quantities">
        {p.colors.length > 0 && <span data-bar-swatch class="w-8 h-8 max-[399px]:hidden rounded-full shrink-0 border border-zinc-300 dark:border-white/20" style={`background:${p.colors[0].hex}`} aria-hidden="true"></span>}
        <span class="min-w-0 leading-tight">
          <span data-bar-color class="block truncate text-[14px] font-semibold text-zinc-900 dark:text-white">{p.colors[0]?.name ?? p.name}</span>
          <span class="block mt-0.5 text-[12.5px] muted truncate"><b data-bar-total class="text-zinc-900 dark:text-white">0</b> pieces · min {min}</span>
        </span>
      </button>
      <button type="submit" form="add-to-quote" data-bar-submit class="btn-primary h-12 px-3.5 text-[14px] shrink-0 disabled:opacity-50 disabled:shadow-none aria-busy:cursor-wait" disabled>
        <ShoppingBag class="w-4 h-4" aria-hidden="true" /><span>Add to cart</span>
      </button>
    </div>
  </div>

  <DesignRequestSheet />
  <OrderSheet />

  <!-- Shown after "Add to cart". -->
  <div id="cart-toast" hidden class="fixed z-[70] inset-x-3 bottom-[calc(88px+env(safe-area-inset-bottom))] md:inset-x-auto md:right-6 md:bottom-6 md:w-[380px] panel-raised p-4 shadow-2xl transition-all duration-200 opacity-0 translate-y-2 data-[open]:opacity-100 data-[open]:translate-y-0" role="status" aria-live="polite" aria-atomic="true">
    <div class="flex items-start gap-3">
      <img data-toast-img alt="" width="56" height="56" class="w-14 h-14 shrink-0 rounded-xl object-contain bg-zinc-50 dark:bg-white/[0.06] border border-zinc-200/80 dark:border-white/10" />
      <div class="min-w-0 flex-1">
        <p class="flex items-center gap-1.5 text-[15px] font-bold text-zinc-900 dark:text-white"><CircleCheck class="w-[18px] h-[18px] text-emerald-500 shrink-0" aria-hidden="true" />Added to your cart</p>
        <p data-toast-line class="mt-0.5 text-[13px] muted truncate"></p>
      </div>
      <button type="button" data-toast-close class="icon-btn w-9 h-9 shrink-0 -mr-1 -mt-1 border-transparent dark:border-transparent" aria-label="Close"><X class="w-4 h-4" aria-hidden="true" /></button>
    </div>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <a href="/quote-cart/" data-toast-view class="btn-primary h-11 text-[14px]"><span>View cart (<span data-toast-count>1</span>)</span></a>
      <button type="button" data-toast-close class="btn-quiet h-11 text-[14px]">Keep browsing</button>
    </div>
  </div>

  {related.length > 0 && (
    <section class="mt-20">
      <div class="flex items-baseline justify-between gap-4">
        <p class="eyebrow">More {category.toLowerCase()}</p>
        <a href={categoryHref} class="text-[13px] font-semibold text-violet-700 dark:text-violet-300 hover:underline">See all</a>
      </div>
      <div class="mt-6 grid gap-x-3 gap-y-6 md:gap-x-5 md:gap-y-8 grid-cols-2 md:grid-cols-4">{related.map((r) => <ProductCard p={r} />)}</div>
    </section>
  )}
</Base>

<style is:global>
  /* `hidden` must win over the display utilities used on the same elements. */
  #add-to-quote [hidden] { display: none !important; }
</style>

<script>
  import { mountDesign } from '../../components/design/design';
  import { setMaxContext } from '../../lib/max';
  import { addToCart, replaceCartItem, cartCount, cartItem, cartItems, cartPersistsFiles, carryArtwork, getCarry, setCarry } from '../../lib/cart';
  import { MAX_TOTAL_BYTES } from '../../lib/quote';
  import { fetchPrices, money, printSize, type ArtHelp, type ArtHelpType, type PriceItemInput, type PriceResponse } from '../../lib/online';
  import { openOrder, type OrderArtwork } from '../../lib/order-sheet';
  import { countInks, dpiFor, inksOn, type InkCount } from '../../components/design/colors';
  const form = document.getElementById('add-to-quote') as HTMLFormElement;
  const label = document.getElementById('color-name');
  const total = document.getElementById('qty-total')!;
  const hint = document.getElementById('qty-hint')!;
  const button = document.getElementById('request-quote') as HTMLButtonElement;
  const single = document.getElementById('request-single') as HTMLButtonElement;
  const cartError = document.getElementById('cart-error')!;
  const min = Number(form.dataset.min) || 12;
  const on = ['is-on', 'ring-2', 'ring-violet-500', 'ring-offset-2'];
  const swatches = [...document.querySelectorAll<HTMLButtonElement>('.swatch')];
  // Phone action bar mirrors this form's state.
  const barColor = document.querySelector<HTMLElement>('[data-bar-color]');
  const barSwatch = document.querySelector<HTMLElement>('[data-bar-swatch]');
  const barTotal = document.querySelector<HTMLElement>('[data-bar-total]');
  const barSubmit = document.querySelector<HTMLButtonElement>('[data-bar-submit]');
  const plainOnly = [...form.querySelectorAll<HTMLElement>('[data-plain-only]')];
  let color = swatches[0]?.dataset.name || '';
  let colorImg = swatches[0]?.dataset.img || '';
  // Max's sheet opens already knowing the product and color.
  const maxContext = () => setMaxContext(`${form.dataset.name || ''}${color ? ` in ${color}` : ''}: `);
  maxContext();

  const inputs = [...form.querySelectorAll<HTMLInputElement>('input[data-size]')];
  const qty = (i: HTMLInputElement) => Math.max(0, Math.min(99999, Math.floor(Number(i.value) || 0)));
  const sum = () => inputs.reduce((n, i) => n + qty(i), 0);
  const d = form.dataset;

  const design = mountDesign(document.querySelector<HTMLElement>('[data-design]')!, {
    summary: form.querySelector<HTMLElement>('[data-design-summary]'),
    sheet: document.getElementById('design-request'),
    getOrder: () => ({
      name: d.name || '', style: d.style || '', brand: d.brand || '', color, cat: d.cat || '', sub: d.sub || '',
      url: location.origin + location.pathname,
      sizes: inputs.filter((i) => qty(i) > 0).map((i) => ({ size: i.dataset.size || '', n: qty(i) })),
      total: sum(),
    }),
    onChange: () => refresh(),
  });

  form.querySelector('[data-art-upload]')?.addEventListener('click', () => design.pickFile());

  swatches.forEach((b) => b.addEventListener('click', () => {
    swatches.forEach((x) => { on.forEach((c) => x.classList.toggle(c, x === b)); x.setAttribute('aria-checked', String(x === b)); });
    color = b.dataset.name || '';
    colorImg = b.dataset.img || '';
    if (label) label.textContent = color;
    if (barColor) barColor.textContent = color;
    maxContext();
    if (barSwatch) barSwatch.style.background = b.style.background;
    design.setColor({ name: color, front: colorImg, back: b.dataset.back || '' });
  }));

  document.getElementById('more-colors')?.addEventListener('click', (e) => {
    swatches.forEach((b) => { b.hidden = false; });
    (e.currentTarget as HTMLElement).remove();
  });

  function refresh() {
    const n = sum();
    const placed = design?.count() ?? 0;
    total.textContent = String(n);
    button.disabled = n < min;
    if (single) single.disabled = n < min;
    if (n >= min && cartError) cartError.textContent = '';
    if (barTotal) barTotal.textContent = String(n);
    if (barSubmit) barSubmit.disabled = n < min;
    plainOnly.forEach((f) => { f.hidden = placed > 0; });
    hint.textContent = n === 0 ? `Enter at least ${min} pieces to add this product to your cart.`
      : n < min ? `Add ${min - n} more piece${min - n === 1 ? '' : 's'} to reach the ${min}-piece minimum for this product.`
      : placed ? `${n} pieces with your artwork. Order it now, or add it to your cart.`
      : `${n} pieces. Order it now, or add it to your cart.`;
    window.dispatchEvent(new Event('tbsp-pdp-change'));
  }
  inputs.forEach((i) => i.addEventListener('input', refresh));
  document.querySelector('[data-bar-sizes]')?.addEventListener('click', () => {
    const first = inputs.find((i) => !qty(i)) ?? inputs[0];
    first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    first?.focus({ preventScroll: true });
  });
  if (swatches[0]) design.init({ name: color, front: colorImg, back: swatches[0].dataset.back || '' });
  refresh();

  // ── quote cart ──────────────────────────────────────────────────────────────
  const toast = document.getElementById('cart-toast')!;
  const checked = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((c) => c.value);
  const sizesMap = () => Object.fromEntries(inputs.filter((i) => qty(i) > 0).map((i) => [i.dataset.size || '', qty(i)]));

  /** The previous flow: one product straight to the quote form (or the design sheet with artwork). */
  function requestSingle() {
    const n = sum();
    if (n < min) { inputs[0]?.focus(); return; }
    if (design.count()) { design.openRequest(); return; }
    const q = new URLSearchParams();
    q.set('product', d.name || '');
    if (d.style) q.set('style', d.style);
    if (d.brand) q.set('brand', d.brand);
    if (color) q.set('color', color);
    q.set('sizes', inputs.filter((i) => qty(i) > 0).map((i) => `${i.dataset.size}:${qty(i)}`).join(','));
    q.set('qty', String(n));
    const decorations = checked('decoration');
    if (decorations.length) q.set('decorations', decorations.join(','));
    const locations = checked('location');
    if (locations.length) q.set('locations', locations.join(','));
    if (d.cat) q.set('cat', d.cat);
    if (d.sub) q.set('sub', d.sub);
    q.set('img', colorImg || d.img || '');
    location.href = `/quick-quote/?${q.toString()}`;
  }
  single.addEventListener('click', requestSingle);

  let toastTimer = 0;
  const closeToast = () => {
    clearTimeout(toastTimer);
    toast.removeAttribute('data-open');
    setTimeout(() => { if (!toast.hasAttribute('data-open')) toast.hidden = true; }, 200);
  };
  toast.querySelectorAll('[data-toast-close]').forEach((b) => b.addEventListener('click', closeToast));
  toast.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeToast(); });
  function showToast(line: string, img: string) {
    toast.querySelector<HTMLElement>('[data-toast-line]')!.textContent = line;
    toast.querySelector<HTMLElement>('[data-toast-count]')!.textContent = String(cartCount());
    toast.querySelector<HTMLAnchorElement>('[data-toast-view]')!.setAttribute('aria-label', `View your cart, ${cartCount()} product${cartCount() === 1 ? '' : 's'}`);
    const im = toast.querySelector<HTMLImageElement>('[data-toast-img]')!;
    im.src = img;
    toast.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => toast.setAttribute('data-open', '')));
    clearTimeout(toastTimer);
    // Stays while it has focus or the pointer; otherwise steps aside after a while.
    const arm = () => { clearTimeout(toastTimer); toastTimer = window.setTimeout(() => { if (!toast.matches(':hover,:focus-within')) closeToast(); else arm(); }, 9000); };
    arm();
  }

  const MB = (n: number) => `${(n / 1024 / 1024).toFixed(1)} MB`;
  // "Edit" from the quote cart: /catalog/<slug>/?edit=<item id> loads that item here and saves over it.
  const editId = new URLSearchParams(location.search).get('edit');
  const editing = editId ? cartItem(editId) : undefined;
  const editItem = editing && editing.slug === d.slug ? editing : undefined;
  const actionText = editItem ? 'Save changes' : 'Add to cart';
  let adding = false;
  async function addItem() {
    if (adding) return;
    cartError.textContent = '';
    const n = sum();
    if (n < min) { cartError.textContent = `Add at least ${min} pieces of this product (${min}-piece minimum per product).`; inputs.find((i) => !qty(i))?.focus(); return; }
    // All artwork in the quote travels in one request: keep it under the 25 MB limit.
    const cartBytes = cartItems().filter((it) => it.id !== editItem?.id).reduce((n, it) => n + it.placements.reduce((a, p) => a + p.size, 0), 0);
    const mine = design.bytes();
    if (cartBytes + mine > MAX_TOTAL_BYTES) {
      cartError.textContent = `Your cart would have ${MB(cartBytes + mine)} of artwork, more than the 25 MB we can take in one request. Send your quote first, or use smaller files (PNG or PDF).`;
      return;
    }
    adding = true;
    const labels = [button, barSubmit].filter(Boolean).map((b) => b!.querySelector('span')!);
    [button, barSubmit].forEach((b) => b?.setAttribute('aria-busy', 'true'));
    labels.forEach((l) => { l.textContent = 'Adding…'; });
    try {
      const placements = design.snapshot();
      const shots = placements.length ? await design.mockups(Math.max(400_000, Math.min(3_000_000, MAX_TOTAL_BYTES - cartBytes - mine - 2_000_000))) : [];
      const input = {
        productId: d.id || '', slug: d.slug || '', name: d.name || '', brand: d.brand || '', style: d.style || '', cat: d.cat || '', sub: d.sub || '',
        image: colorImg || d.img || '', url: location.origin + location.pathname, color,
        sizeOrder: inputs.map((i) => i.dataset.size || ''), sizes: sizesMap(),
        decorations: placements.length ? [...new Set(placements.map((p) => p.decoration))] : checked('decoration'),
        locations: placements.length ? placements.map((p) => p.location) : checked('location'),
        placements, mockups: shots.map((m) => ({ side: m.side, blob: m.blob })),
        inks: Object.fromEntries(effectiveInks),
        ...artHelpInput(),
      };
      if (editItem) {
        await replaceCartItem(editItem.id, input);
        location.href = '/quote-cart/';
        return;
      }
      const item = await addToCart(input);
      setCarry(null);
      design.clearCarried();
      if (!(await cartPersistsFiles()) && placements.length) {
        cartError.textContent = "Your browser isn't letting us save files, so keep this tab open until you check out or send your quote.";
      }
      inputs.forEach((i) => { i.value = ''; });
      refresh();
      showToast(`${item.name}${item.color ? ` · ${item.color}` : ''} · ${item.total} pieces`, item.image);
    } catch (e) {
      cartError.textContent = e instanceof Error ? e.message : 'Could not add this product. Please try again.';
    } finally {
      adding = false;
      [button, barSubmit].forEach((b) => b?.removeAttribute('aria-busy'));
      labels.forEach((l) => { l.textContent = actionText; });
    }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); addItem(); });

  if (editItem) {
    // Same color, sizes, decoration and artwork as in the quote; the buttons save over it.
    const sw = swatches.find((b) => b.dataset.name === editItem.color);
    if (sw) { sw.hidden = false; sw.click(); }
    inputs.forEach((i) => { const v = editItem.sizes[i.dataset.size || '']; i.value = v ? String(v) : ''; });
    form.querySelectorAll<HTMLInputElement>('input[name="decoration"]').forEach((c) => { c.checked = editItem.decorations.includes(c.value); });
    form.querySelectorAll<HTMLInputElement>('input[name="location"]').forEach((c) => { c.checked = editItem.locations.includes(c.value); });
    [button, barSubmit].forEach((b) => { const l = b?.querySelector('span'); if (l) l.textContent = actionText; });
    single.hidden = true;
    const head = form.querySelector('p');
    if (head) {
      head.textContent = 'Edit this product';
      const back = document.createElement('a');
      back.href = '/quote-cart/';
      back.className = 'ml-3 text-[13px] font-semibold text-violet-700 dark:text-violet-300 hover:underline';
      back.textContent = 'Cancel';
      head.append(back);
    }
    refresh();
    if (editItem.placements.length) {
      carryArtwork(editItem.id)
        .then((list) => { if (list.length) design.loadArtwork(list, editItem.name, 'Your artwork from the quote is loaded. Move or resize it, then tap Save changes.'); })
        .catch(() => {});
    }
  } else {
    // "Use same artwork on another product": start this page with that item's artwork.
    const carryId = getCarry();
    if (carryId) {
      const from = cartItem(carryId);
      carryArtwork(carryId).then((list) => { if (list.length) design.loadArtwork(list, from ? `${from.name}` : ''); }).catch(() => {});
    }
  }

  document.querySelector('[data-pending-dismiss]')?.addEventListener('click', () => setCarry(null));

  // ── instant price + "Order & pay" (online orders) ────────────────────────────
  const instant = form.querySelector<HTMLElement>('[data-instant]')!;
  const ip = (k: string) => instant.querySelector<HTMLElement>(`[data-ip-${k}]`)!;
  const orderBtn = ip('order') as HTMLButtonElement;
  const inks = new Map<string, number>();
  const isScreen = (m: string) => /screen/i.test(m);
  let priceTimer = 0;
  let priceCtl: AbortController | null = null;
  let lastPrice: Extract<PriceResponse, { enabled: true }> | null = null;
  let lastInput: { item: PriceItemInput; artwork: OrderArtwork[] } | null = null;

  /** The product as the studio prices it, or a reason it can't be priced yet. */
  /** Detected ink colors per placed artwork, keyed by location + file. */
  const detected = new Map<string, InkCount | 'pending'>();
  /** The selected garment color as CSS (inks that match it don't print). */
  const garmentColor = () => swatches.find((b) => b.getAttribute('aria-checked') === 'true')?.style.background || '';
  const artKey = (loc: string, p: { file: string; blob: Blob }) => `${loc}|${p.file}|${p.blob.size}`;
  /** Ink colors a screen printed location is priced at: what the artwork shows, never less. */
  const effectiveInks = new Map<string, number>();
  type Row = { placement: string; method: string; ink?: InkCount | 'pending'; widthIn?: number };
  let inkRows: Row[] = [];

  function priceInput(): { item: PriceItemInput; artwork: OrderArtwork[] } | string {
    const n = sum();
    if (n < min) return `Enter at least ${min} pieces to see your price.`;
    const placements = design.snapshot();
    effectiveInks.clear();
    inkRows = [];
    const ink = (place: string, method: string, found?: InkCount | 'pending') => {
      if (!isScreen(method)) return {};
      const auto = found && found !== 'pending' && found.kind === 'spot' ? inksOn(found, garmentColor()).length : 0;
      // Full color can't be screen printed at an instant price: the studio answers "priced by quote".
      const colors = found && found !== 'pending' && found.kind === 'full' ? 99 : Math.max(auto, inks.get(place) || 1);
      effectiveInks.set(place, colors);
      return { colors };
    };
    let locations: PriceItemInput['locations'];
    if (placements.length) {
      locations = placements.map((p) => {
        const found = detected.get(artKey(p.location, p));
        if (isScreen(p.decoration)) inkRows.push({ placement: p.location, method: p.decoration, ink: found, widthIn: p.widthIn });
        else if (found && found !== 'pending') inkRows.push({ placement: p.location, method: p.decoration, ink: found, widthIn: p.widthIn });
        return { placement: p.location, method: p.decoration, ...ink(p.location, p.decoration, found), ...printSize(p.widthIn, p.heightIn) };
      });
    } else {
      const decos = checked('decoration'), locs = checked('location');
      if (!decos.length) return 'Choose a decoration to see your price.';
      if (!locs.length) return 'Choose a print location to see your price.';
      locations = locs.map((l) => {
        if (isScreen(decos[0])) inkRows.push({ placement: l, method: decos[0] });
        return { placement: l, method: decos[0], ...ink(l, decos[0]) };
      });
    }
    return {
      item: { brand: d.brand || '', style: d.style || '', color, sizes: sizesMap(), locations, productName: d.name || '', ...artHelpInput() },
      artwork: placements.map((p) => ({ itemIndex: 0, placement: p.location, file: new File([p.blob], p.file, { type: p.blob.type }) })),
    };
  }

  /** Counts the ink colors of newly placed artwork, then re-prices. */
  function detectArtwork() {
    for (const p of design.snapshot()) {
      const k = artKey(p.location, p);
      if (detected.has(k)) continue;
      detected.set(k, 'pending');
      countInks(p.blob).then((r) => { detected.set(k, r); schedulePrice(0); }).catch(() => { detected.set(k, { kind: 'unknown' }); schedulePrice(0); });
    }
  }

  /** Per location: the ink colors found in the artwork (screen printing is priced by colors). */
  function renderInks() {
    const box = ip('inks');
    const key = JSON.stringify([garmentColor(), inkRows.map((r) => [r.placement, r.method, r.ink === 'pending' ? 'p' : r.ink?.kind, r.ink && r.ink !== 'pending' && r.ink.kind === 'spot' ? r.ink.count : 0])]);
    if (box.dataset.key === key) return;
    box.dataset.key = key;
    box.replaceChildren();
    for (const r of inkRows) {
      const screen = isScreen(r.method);
      const found = r.ink && r.ink !== 'pending' ? r.ink : null;
      const row = document.createElement('div');
      row.className = 'flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 text-[13.5px]';
      const t = document.createElement('span');
      t.className = 'min-w-0 flex items-center gap-2 text-zinc-800 dark:text-zinc-200';
      const label = document.createElement('span');
      const shown = found?.kind === 'spot' ? inksOn(found, garmentColor()) : [];
      if (r.ink === 'pending') label.textContent = `${r.placement}: checking your artwork colors…`;
      else if (found?.kind === 'full') label.innerHTML = `<b>${r.placement}:</b> full-color design`;
      else if (found?.kind === 'spot') label.innerHTML = `<b>${r.placement}:</b> ${shown.length} ink color${shown.length === 1 ? '' : 's'} found`;
      else label.textContent = `${r.placement}: ink colors in your design`;
      t.append(label);
      if (shown.length) {
        const dots = document.createElement('span');
        dots.className = 'flex -space-x-1';
        dots.setAttribute('aria-hidden', 'true');
        for (const c of shown) { const dot = document.createElement('span'); dot.className = 'w-4 h-4 rounded-full border border-zinc-300 dark:border-white/30'; dot.style.background = c; dots.append(dot); }
        t.append(dots);
      }
      row.append(t);
      if (screen && found?.kind !== 'full' && r.ink !== 'pending') {
        // The count can go up (the customer knows better) but never below what the artwork shows.
        const floor = shown.length || 1;
        const sel = document.createElement('select');
        sel.className = 'field !h-9 !w-auto !py-0 !pr-8 !text-[14px] font-semibold';
        for (let c = floor; c <= 6; c++) { const o = document.createElement('option'); o.value = String(c); o.textContent = c === 6 ? '6+' : String(c); sel.append(o); }
        sel.value = String(Math.max(floor, inks.get(r.placement) || floor));
        sel.setAttribute('aria-label', `Ink colors on the ${r.placement.toLowerCase()}`);
        sel.addEventListener('change', () => { inks.set(r.placement, Number(sel.value)); schedulePrice(0); });
        row.append(sel);
      }
      box.append(row);
      const note = document.createElement('p');
      note.className = 'text-[12.5px] muted -mt-1';
      if (screen && found?.kind === 'full') note.textContent = 'Photos, gradients and 7+ colors are best printed with DTG or DTF (no color charge). Change the decoration for this location to see an instant price, or add it to your quote.';
      else if (screen && !found && r.ink !== 'pending' && design.count()) note.textContent = "We couldn't read this file type. Pick the ink colors; we confirm them on your proof.";
      else if (screen && !design.count()) note.textContent = 'We confirm ink colors from your artwork on the proof.';
      if (found && found.kind !== 'unknown' && !found.vector && r.widthIn) {
        const dpi = dpiFor(found.widthPx, r.widthIn);
        if (dpi && dpi < 150 && found.widthPx) note.textContent = `${note.textContent ? `${note.textContent} ` : ''}This artwork is low resolution for its size (about ${dpi} DPI at ${Math.round(r.widthIn * 10) / 10}" wide). A larger file prints sharper.`;
      }
      if (note.textContent) box.append(note);
    }
  }

  // ── artwork help ──
  const artBox = ip('art');
  const artOn = artBox.querySelector<HTMLInputElement>('[data-art-on]')!;
  const artOpts = artBox.querySelector<HTMLElement>('[data-art-opts]')!;
  const artNotes = artBox.querySelector<HTMLTextAreaElement>('[data-art-notes]')!;
  const artType = () => (artBox.querySelector<HTMLInputElement>('input[name="artHelp"]:checked')?.value || 'cleanup') as ArtHelpType;
  let artOffered = false;
  function artHelpInput(): { artHelp?: ArtHelp } {
    if (!artOffered || !artOn.checked) return {};
    const notes = artNotes.value.trim().slice(0, 1000);
    return { artHelp: { type: artType(), ...(notes ? { notes } : {}) } };
  }
  function renderArtHelp(res: Extract<PriceResponse, { enabled: true }>) {
    const o = res.artHelp;
    artOffered = !!(o && (o.cleanup || o.layout || o.custom));
    artBox.hidden = !artOffered;
    if (!o || !artOffered) return;
    (['cleanup', 'layout', 'custom'] as ArtHelpType[]).forEach((k) => {
      const opt = o[k];
      const row = artBox.querySelector<HTMLElement>(`[data-art-opt="${k}"]`)!;
      row.hidden = !opt;
      artBox.querySelector(`[data-art-price="${k}"]`)!.textContent = opt ? `${k === 'custom' || (opt as { from?: boolean }).from ? 'from ' : ''}${money(opt.price)}` : '';
    });
    const terms = [`${o.revisionsIncluded ?? 2} revision${(o.revisionsIncluded ?? 2) === 1 ? '' : 's'} included${o.revisionPrice ? `, then ${money(o.revisionPrice)} each` : ''}`, o.extraDays ? `adds about ${o.extraDays} business days before your proof` : '', 'non-refundable once work starts'].filter(Boolean);
    artBox.querySelector('[data-art-terms]')!.textContent = `${terms.join(' · ')}. You get the final file.`;
    // Suggest it when the artwork has a problem, or when there's no artwork yet.
    const sug = artBox.querySelector<HTMLElement>('[data-art-suggest]')!;
    const rows = inkRows.filter((r) => r.ink && r.ink !== 'pending' && r.ink.kind !== 'unknown');
    const lowRes = rows.some((r) => { const f = r.ink as Exclude<InkCount, { kind: 'unknown' }>; return !f.vector && r.widthIn && dpiFor(f.widthPx, r.widthIn) < 150; });
    const offer = !artOn.checked && (lowRes && o.cleanup ? { type: 'cleanup' as ArtHelpType, text: 'Your file may print soft.' } : !design.count() && o.layout ? { type: 'layout' as ArtHelpType, text: 'No artwork yet? We can make it for you.' } : null);
    sug.hidden = !offer;
    if (offer) {
      sug.querySelector('[data-art-suggest-text]')!.textContent = offer.text;
      const b = sug.querySelector<HTMLButtonElement>('[data-art-suggest-btn]')!;
      const price = o[offer.type]!.price;
      b.textContent = `${offer.type === 'cleanup' ? 'Add art cleanup' : 'Get design help'} (${offer.type === 'custom' ? 'from ' : ''}${money(price)})`;
      b.onclick = () => {
        artOn.checked = true;
        artBox.querySelector<HTMLInputElement>(`input[name="artHelp"][value="${offer.type}"]`)!.checked = true;
        artOpts.hidden = false;
        sug.hidden = true;
        schedulePrice(0);
        artNotes.focus();
      };
    }
  }
  artOn.addEventListener('change', () => { artOpts.hidden = !artOn.checked; schedulePrice(0); });
  artBox.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).name === 'artHelp') schedulePrice(0); });
  artNotes.addEventListener('input', () => schedulePrice(800));
  // Editing a cart item that had artwork help: keep it selected.
  if (editItem?.artHelp) {
    artOn.checked = true;
    artOpts.hidden = false;
    artBox.querySelector<HTMLInputElement>(`input[name="artHelp"][value="${editItem.artHelp.type}"]`)!.checked = true;
    artNotes.value = editItem.artHelp.notes || '';
  }

  function showPrice(res: PriceResponse | null, input: { item: PriceItemInput; artwork: OrderArtwork[] } | null) {
    if (!res || !res.enabled) { instant.hidden = true; lastPrice = null; button.classList.replace('btn-quiet', 'btn-primary'); return; }
    instant.hidden = false;
    renderArtHelp(res);
    const it = res.items[0];
    const ok = !!(input && it?.ok && res.totals);
    ip('body').hidden = !ok;
    orderBtn.hidden = !ok;
    ip('foot').hidden = !ok;
    // With a price on screen, "Order & pay" leads and "Add to cart" steps back.
    button.classList.replace(ok ? 'btn-primary' : 'btn-quiet', ok ? 'btn-quiet' : 'btn-primary');
    ip('quote').hidden = ok;
    ip('status').textContent = '';
    if (!ok) {
      ip('quote').textContent = it?.quoteOnly ? `${it.quoteOnly}. Add it to your cart and request a quote, and we'll price it for you.` : '';
      lastPrice = null;
      return;
    }
    lastPrice = res; lastInput = input;
    const prices = Object.values(it.sizePrices);
    const lo = Math.min(...prices), hi = Math.max(...prices);
    ip('each').textContent = lo === hi ? money(lo) : `${money(lo)}–${money(hi)}`;
    const extra = Object.entries(it.sizePrices).filter(([, p]) => p > lo);
    ip('sizes').textContent = extra.length ? `${extra.map(([s]) => s).join(', ')}: ${money(Math.max(...extra.map(([, p]) => p)))} each (larger sizes cost more)` : '';
    const dl = ip('lines');
    dl.replaceChildren();
    const line = (a: string, b: string, strong = false) => {
      const dt = document.createElement('dt'); dt.className = strong ? 'font-bold text-zinc-900 dark:text-white' : 'muted'; dt.textContent = a;
      const dd = document.createElement('dd'); dd.className = `text-right ${strong ? 'font-bold' : 'font-semibold'} text-zinc-900 dark:text-white`; dd.textContent = b;
      dl.append(dt, dd);
    };
    line(`${it.quantity} pieces`, money(it.subtotal));
    if (it.setup) line('Setup / screens', money(it.setup));
    if (it.artFee) line('Artwork help', money(it.artFee));
    line('Total before tax', money(res.totals!.subtotal + res.totals!.setup + (res.totals!.art || 0)), true);
    ip('next').hidden = !it.next;
    if (it.next) ip('next').textContent = `Order ${it.next.qty} or more and pay ${money(it.next.perPiece)} each.`;
    ip('stock').hidden = !it.stockShort.length;
    if (it.stockShort.length) ip('stock').textContent = `Low stock: ${it.stockShort.map((s) => `${s.size} (${s.stock} left)`).join(', ')}. We'll confirm a replacement before printing.`;
  }

  async function runPrice() {
    const input = priceInput();
    priceCtl?.abort();
    if (typeof input === 'string') {
      inkRows = []; renderInks();
      if (!instant.hidden || lastPrice) { ip('body').hidden = true; orderBtn.hidden = true; ip('foot').hidden = true; ip('quote').hidden = false; ip('quote').textContent = input; }
      lastPrice = null;
      return;
    }
    renderInks();
    ip('status').textContent = 'Updating…';
    orderBtn.disabled = true;
    priceCtl = new AbortController();
    const res = await fetchPrices([input.item], 'pickup', priceCtl.signal);
    if (priceCtl.signal.aborted) return;
    orderBtn.disabled = false;
    showPrice(res, input);
  }
  function schedulePrice(delay = 450) { clearTimeout(priceTimer); priceTimer = window.setTimeout(() => { detectArtwork(); runPrice(); }, delay); }

  window.addEventListener('tbsp-pdp-change', () => schedulePrice());
  form.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('input[name="decoration"],input[name="location"]')) schedulePrice(0); });
  swatches.forEach((b) => b.addEventListener('click', () => schedulePrice(0)));
  // Ask once at load: when online orders are off the section never shows.
  fetchPrices([{ brand: d.brand || '', style: d.style || '', color, sizes: {}, locations: [] }]).then((r) => {
    if (r?.enabled) { instant.hidden = false; runPrice(); }
  });

  orderBtn.addEventListener('click', async () => {
    const input = priceInput();
    if (typeof input === 'string' || !lastPrice) return;
    orderBtn.disabled = true;
    const res = await fetchPrices([input.item]);
    orderBtn.disabled = false;
    if (!res?.enabled || !res.items[0]?.ok || !res.totals) { showPrice(res, input); return; }
    openOrder({ items: [input.item], artwork: input.artwork, price: res, summary: `${d.name}${color ? ` · ${color}` : ''} · ${sum()} pieces` });
  });
</script>
