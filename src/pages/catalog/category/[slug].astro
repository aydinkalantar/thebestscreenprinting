---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaBand from '../../../components/CtaBand.astro';
import CollectionChips from '../../../components/catalog/CollectionChips.astro';
import ProductBrowser from '../../../components/catalog/ProductBrowser.astro';
import { collectionHeading, methodsSentence } from '../../../components/catalog/copy';
import { COLLECTIONS, collectionProducts, collectionHref, type CatalogProduct } from '../../../lib/catalog';
import { business } from '../../../data/business';

export function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { slug: c.slug }, props: { label: c.label, items: collectionProducts(c.slug) } }))
    .filter((x) => x.props.items.length > 0);
}
const { slug } = Astro.params as { slug: string };
const { label, items } = Astro.props as { label: string; items: CatalogProduct[] };
const heading = collectionHeading(slug, label);
const methods = methodsSentence(items);
const url = `${business.url}${collectionHref(slug)}`;
const description = `${heading} with your logo, made in our own shops in Los Angeles and Cleveland. ${items.length} style${items.length === 1 ? '' : 's'}${methods ? ` with ${methods}` : ''}. Orders start at ${business.shopMinimum} pieces.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: heading,
    url,
    numberOfItems: items.length,
    itemListElement: items.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${business.url}/catalog/${p.slug}/`, name: p.name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Catalog', item: `${business.url}/catalog/` },
      { '@type': 'ListItem', position: 3, name: label, item: url },
    ],
  },
];
---
<Base title={`${heading} with Your Logo | TBSP`} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Catalog', href: '/catalog/' }, { label }]} />
  <p class="eyebrow">Catalog · {label}</p>
  <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white">{heading}</h1>
  <p class="mt-2 text-[15px] sm:text-base muted max-w-2xl">
    {items.length} style{items.length === 1 ? '' : 's'} ready for your logo, printed in-house in Los Angeles and Cleveland. Orders start at {business.shopMinimum} pieces.{methods && ` Available with ${methods}.`}
  </p>

  <CollectionChips current={slug} label="Other categories" class="md:hidden" />
  <ProductBrowser products={items} categories current={slug} />

  <div class="mt-20"><CtaBand title="Don't see it?" text="We print on almost anything: your own garments, brands we don't list, special finishes. Tell us what you have in mind." /></div>
</Base>
