---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
import { LEAD_SOURCES, DECORATIONS, GARMENTS } from '../lib/quote';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Upload, Phone, Mail, Clock, Send, BadgeCheck, ClipboardList, ArrowRight } from '@lucide/astro';

const page = await getEntry('pages', 'quick-quote');
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title={page?.data.title ?? 'Get a Quote | TBSP'} description="Request a custom apparel printing quote from our Los Angeles shop. Screen printing, embroidery, DTF and more. We reply within one business day.">
  <Breadcrumbs items={[{ label: 'Get a quote' }]} />
  <div class="grid gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0">
      <p class="eyebrow">Get a quote</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-white">Tell us what you need</h1>
      <p class="mt-4 text-lg muted max-w-2xl">We reply with a personal quote within one business day. Everything is made in our own shops, and orders start at {business.shopMinimum} pieces.</p>

      <!-- Shown when the quote cart has products (filled by the script below). -->
      <a id="cart-banner" href="/quote-cart/" hidden class="mt-6 panel p-4 flex items-center gap-3 border-violet-400/50 bg-violet-500/[0.06] hover:bg-violet-500/10 transition-colors">
        <span class="w-10 h-10 shrink-0 rounded-xl grid place-items-center bg-violet-600 text-white"><ClipboardList class="w-5 h-5" aria-hidden="true" /></span>
        <span class="min-w-0 flex-1 leading-snug">
          <span class="block text-[15px] font-semibold text-zinc-900 dark:text-white" data-cart-banner-text>You have products in your cart</span>
          <span class="block text-[13px] muted">Review them and send them together, or use this form for something else.</span>
        </span>
        <span class="shrink-0 inline-flex items-center gap-1 text-[14px] font-semibold text-violet-700 dark:text-violet-300">Review<span class="max-sm:hidden">&nbsp;them</span><ArrowRight class="w-4 h-4" aria-hidden="true" /></span>
      </a>

      <form id="quote-form" class="mt-8 max-md:mt-6 panel-raised p-4 sm:p-7 grid grid-cols-[minmax(0,1fr)] gap-8" novalidate enctype="multipart/form-data">
        <!-- Filled in when the visitor comes from a product's "Add to quote" panel. -->
        <div id="product-summary" class="hidden panel p-3 sm:p-4 items-center gap-4 bg-zinc-50 dark:bg-white/[0.03]">
          <img data-s="img" alt="" width="80" height="80" hidden class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-xl object-contain bg-white dark:bg-white/[0.04] border border-zinc-200/80 dark:border-white/10" />
          <div class="min-w-0">
            <p class="eyebrow">Your selection</p>
            <p data-s="name" class="mt-1 font-semibold leading-snug text-zinc-900 dark:text-white"></p>
            <p data-s="meta" class="mt-0.5 text-[13px] muted"></p>
            <p data-s="sizes" class="mt-0.5 text-[13px] muted"></p>
          </div>
        </div>
        <fieldset class="grid gap-5">
          <legend class="text-lg font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2"><span class="w-7 h-7 rounded-full grid place-items-center bg-violet-600 text-white text-xs">1</span>Your order</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="label"><span>What do you want printed?</span>
              <select name="garment" class="field" required>
                <option value="">Choose one</option>
                {GARMENTS.map((g) => <option>{g}</option>)}
              </select>
              <span class="err" data-for="garment"></span>
            </label>
            <label class="label"><span>Quantity</span>
              <input name="quantity" class="field" type="number" min={business.shopMinimum} inputmode="numeric" pattern="[0-9]*" enterkeyhint="next" placeholder="e.g. 50" required />
              <span class="text-[12px] muted">Minimum {business.shopMinimum} pieces</span>
              <span class="err" data-for="quantity"></span>
            </label>
          </div>
          <div class="grid gap-2" role="group" aria-label="Decoration">
            <span class="label"><span>Decoration <small>(pick any)</small></span></span>
            <div class="flex flex-wrap gap-2">
              {DECORATIONS.map((d) => <label class="chip max-md:h-auto max-md:min-h-[44px] max-md:py-2 max-md:px-4 max-md:text-[14px] cursor-pointer has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 has-[:checked]:text-violet-700 dark:has-[:checked]:text-violet-300"><input type="checkbox" name="decorations" value={d} class="accent-violet-600" />{d}</label>)}
            </div>
          </div>
          <div class="grid gap-2" role="radiogroup" aria-label="Turnaround">
            <span class="label"><span>Turnaround</span></span>
            <div class="flex flex-wrap gap-2">
              {business.turnaround.map((t, i) => <label class="chip max-md:h-auto max-md:min-h-[44px] max-md:py-2 max-md:px-4 max-md:text-[14px] cursor-pointer has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 has-[:checked]:text-violet-700 dark:has-[:checked]:text-violet-300"><input type="radio" name="turnaround" value={t.id} checked={i === 0} class="accent-violet-600" />{t.name} <span class="muted font-medium">· {t.time}{t.fee ? ` · ${t.fee}` : ''}</span></label>)}
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="label"><span>Needed by <small>(optional)</small></span>
              <input name="deadline" class="field min-w-0 appearance-none" type="date" />
            </label>
            <label class="label"><span>Artwork <small>(optional, up to 10 MB)</small></span>
              <span class="field !h-auto py-2 flex items-center gap-2 min-w-0"><Upload class="w-4 h-4 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><input name="artwork" type="file" class="min-w-0 w-full text-[13px] file:mr-3 file:rounded-lg file:border-0 file:bg-violet-500/10 file:px-3 file:py-1.5 file:text-violet-700 dark:file:text-violet-300 file:font-semibold" accept=".png,.jpg,.jpeg,.webp,.svg,.pdf,.ai,.eps,.psd" /></span>
              <span class="err" data-for="artwork"></span>
            </label>
          </div>
          <label class="label"><span>Details <small>(optional)</small></span>
            <textarea name="details" class="field" rows="4" placeholder="Colors, sizes, print locations, anything else"></textarea>
          </label>
        </fieldset>

        <fieldset class="grid gap-5">
          <legend class="text-lg font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2"><span class="w-7 h-7 rounded-full grid place-items-center bg-violet-600 text-white text-xs">2</span>Where should we send the quote?</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="label"><span>Name</span><input name="name" class="field" autocomplete="name" autocapitalize="words" enterkeyhint="next" required /><span class="err" data-for="name"></span></label>
            <label class="label"><span>Email</span><input name="email" class="field" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" required /><span class="err" data-for="email"></span></label>
            <label class="label"><span>Phone <small>(optional)</small></span><input name="phone" class="field" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" /></label>
            <label class="label"><span>Company or team <small>(optional)</small></span><input name="company" class="field" autocomplete="organization" enterkeyhint="next" /></label>
          </div>
          <label class="label"><span>How did you find us? <small>(optional)</small></span>
            <select name="leadSource" class="field">
              <option value="">Choose one</option>
              {LEAD_SOURCES.map((s) => <option value={s.id}>{s.label}</option>)}
            </select>
          </label>
        </fieldset>

        <!-- Hidden from people; bots fill it in. -->
        <input class="absolute -left-[9999px] w-px h-px opacity-0" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}

        <p class="text-[12.5px] muted">Mockups are a visual guide. Final print size, placement and colors are confirmed on your proof before production.</p>
        <p class="form-msg hidden rounded-xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></p>
        <!-- Phones: the submit button stays in reach at the bottom while filling the form. -->
        <div class="md:contents max-md:sticky max-md:z-10 max-md:bottom-[var(--tabbar-h)] max-md:-mx-4 max-md:-mb-4 max-md:px-4 max-md:pt-3 max-md:pb-[calc(12px+var(--orb-rise))] max-md:rounded-b-2xl max-md:bg-white/90 dark:max-md:bg-[#0d0d14]/90 max-md:backdrop-blur-xl max-md:border-t max-md:border-zinc-200/80 dark:max-md:border-white/10">
          <button class="btn-primary justify-self-start max-md:w-full max-md:h-12 max-md:text-[15px]" type="submit"><Send class="w-4 h-4" aria-hidden="true" /><span>Send my quote request</span></button>
        </div>
      </form>
    </div>

    <aside class="min-w-0 space-y-4 lg:sticky lg:top-24 self-start lg:mt-[9.5rem]">
      <div class="panel-raised p-5">
        <p class="eyebrow">Rather talk?</p>
        <div class="mt-3 space-y-2.5 text-sm">
          <p class="flex items-center gap-2"><Phone class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" /><a class="font-semibold" href={`tel:${business.phone}`}>{business.phoneDisplay}</a></p>
          <p class="flex items-center gap-2"><Mail class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" /><a href={`mailto:${business.email}`}>{business.email}</a></p>
          <p class="flex items-center gap-2 muted"><Clock class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Mon–Fri, 9am–5pm</p>
        </div>
      </div>
      <div class="panel p-5 text-sm muted space-y-2">
        <p class="flex gap-2"><BadgeCheck class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true" />Free art check before anything prints</p>
        <p class="flex gap-2"><BadgeCheck class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true" />Quote within one business day</p>
        <p class="flex gap-2"><BadgeCheck class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" aria-hidden="true" />Normal, Rush or Super Rush turnaround</p>
      </div>
    </aside>
  </div>
  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>
<style>#cart-banner[hidden] { display: none; }</style>

<script>
  import { garmentFor } from '../lib/quote';
  import { prefillContact } from '../lib/contact';
  import { cartCount, cartPieces, onCartChange } from '../lib/cart';
  const cartBanner = document.getElementById('cart-banner') as HTMLAnchorElement;
  const showCartBanner = () => {
    const n = cartCount();
    cartBanner.hidden = n === 0;
    cartBanner.querySelector('[data-cart-banner-text]')!.textContent = `You have ${n} product${n === 1 ? '' : 's'} in your cart (${cartPieces()} pieces)`;
  };
  showCartBanner();
  onCartChange(showCartBanner);
  const form = document.getElementById('quote-form') as HTMLFormElement;
  // Details confirmed with Max (or a past order) are filled in.
  if (form) prefillContact(form);
  const query = new URLSearchParams(location.search);
  const clean = (v: string | null, max = 120) => (v || '').replace(/[\u0000-\u001f]/g, ' ').trim().slice(0, max);
  const listParam = (k: string) => clean(query.get(k), 400).split(',').map((x) => x.trim()).filter(Boolean);
  const checkDecorations = (names: string[]) => {
    const wanted = names.map((n) => n.toLowerCase());
    form.querySelectorAll<HTMLInputElement>('input[name="decorations"]').forEach((c) => { if (wanted.includes(c.value.toLowerCase())) c.checked = true; });
  };
  // Coming from a custom-project link: tick that decoration.
  const project = new URLSearchParams(location.search).get('project');
  if (project) {
    form.querySelectorAll<HTMLInputElement>('input[name="decorations"]').forEach((c) => { if (c.value === project) c.checked = true; });
  }
  // Coming from the header's AI box: carry the request into the details.
  const asked = new URLSearchParams(location.search).get('details');
  if (asked) (form.elements.namedItem('details') as HTMLTextAreaElement).value = asked.slice(0, 1000);
  // Coming from a catalog product: note which one in the details box.
  const fromProduct = new URLSearchParams(location.search).get('garment');
  if (fromProduct) {
    const details = form.elements.namedItem('details') as HTMLTextAreaElement;
    details.value = `Product: ${fromProduct.slice(0, 200)}\n`;
  }
  // Coming from a product's "Add to quote" panel:
  // ?product=&style=&brand=&color=&sizes=S:4,M:10&qty=&decorations=&locations=&cat=&sub=&img=
  const product = clean(query.get('product'), 200);
  if (product) {
    const style = clean(query.get('style'), 40);
    const color = clean(query.get('color'), 60);
    const sizes = listParam('sizes')
      .map((x) => /^(.{1,12}):(\d{1,5})$/.exec(x))
      .filter((m): m is RegExpExecArray => !!m && Number(m[2]) > 0)
      .map((m) => ({ size: m[1].trim(), n: Number(m[2]) }));
    const sizeTotal = sizes.reduce((n, x) => n + x.n, 0);
    const qty = Math.floor(Number(query.get('qty'))) || sizeTotal;
    const locations = listParam('locations').map((l) => l.slice(0, 30)).slice(0, 8);
    checkDecorations(listParam('decorations'));

    if (qty > 0) (form.elements.namedItem('quantity') as HTMLInputElement).value = String(Math.min(qty, 100000));

    // Best garment option for the product's category.
    const cat = clean(query.get('cat'), 30), sub = clean(query.get('sub'), 30);
    const garment = garmentFor(cat, sub, product);
    const select = form.elements.namedItem('garment') as HTMLSelectElement;
    if ([...select.options].some((o) => o.value === garment)) select.value = garment;

    const sizeText = sizes.map((x) => `${x.size} ${x.n}`).join(', ');
    const summary = [
      `${product}${style ? ` (style ${style})` : ''}${color ? `, color ${color}` : ''}.`,
      sizeText && `Sizes: ${sizeText}.`,
      locations.length ? `Print: ${locations.join(', ')}.` : '',
    ].filter(Boolean).join(' ');
    (form.elements.namedItem('details') as HTMLTextAreaElement).value = `${summary}\n`;
    // The product itself, for the order the request creates in the admin.
    const meta = document.createElement('input');
    meta.type = 'hidden'; meta.name = 'product';
    meta.value = JSON.stringify({ productName: product, brand: clean(query.get('brand'), 60) || undefined, style: style || undefined, color: color || undefined, sizes: Object.fromEntries(sizes.map((x) => [x.size, x.n])) });
    form.append(meta);

    const card = document.getElementById('product-summary')!;
    const set = (k: string, v: string) => { card.querySelector<HTMLElement>(`[data-s="${k}"]`)!.textContent = v; };
    set('name', product);
    set('meta', [style && `Style ${style}`, color, qty > 0 && `${qty} pieces`].filter(Boolean).join(' · '));
    set('sizes', [sizeText, locations.length ? `Print: ${locations.join(', ')}` : ''].filter(Boolean).join(' · '));
    const img = query.get('img') || '';
    if (/^https:\/\/cdn\.ssactivewear\.com\/[\w\-./%]+$/.test(img)) {
      const el = card.querySelector<HTMLImageElement>('[data-s="img"]')!;
      el.src = img;
      el.alt = product;
      el.hidden = false;
    }
    card.classList.remove('hidden');
    card.classList.add('flex');
  }
  const msg = form.querySelector('.form-msg') as HTMLElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const setErrors = (fields: Record<string, string> = {}) => {
    form.querySelectorAll<HTMLElement>('.err').forEach((el) => { el.textContent = fields[el.dataset.for!] || ''; });
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setErrors();
    msg.textContent = '';
    msg.className = 'form-msg hidden rounded-xl px-4 py-3 text-sm font-medium';
    button.disabled = true;
    button.querySelector('span')!.textContent = 'Sending…';
    try {
      const res = await fetch('/api/quote', { method: 'POST', body: new FormData(form) });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        form.reset();
        msg.className = 'form-msg rounded-xl px-4 py-3 text-sm font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-300';
        msg.textContent = `Thanks! We've got your request and will reply within one business day.${data.ref ? ` Your request number is ${data.ref}.` : ''}`;
      } else {
        setErrors(data.fields);
        msg.className = 'form-msg rounded-xl px-4 py-3 text-sm font-medium bg-red-500/10 text-red-700 dark:text-red-300';
        msg.textContent = data.error || 'Something went wrong. Please try again.';
      }
    } catch {
      msg.className = 'form-msg rounded-xl px-4 py-3 text-sm font-medium bg-red-500/10 text-red-700 dark:text-red-300';
      msg.textContent = 'Network error. Please try again, or call us.';
    } finally {
      button.disabled = false;
      button.querySelector('span')!.textContent = 'Send my quote request';
    }
  });
</script>
