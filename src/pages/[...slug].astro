---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import VideoGrid from '../components/VideoGrid.astro';
import RelatedProducts from '../components/home/RelatedProducts.astro';
import { PAGE_VIDEOS, videoJsonLd } from '../data/videos';
import { business } from '../data/business';
import { heroImage, eyebrowFor, relatedFor } from '../lib/page-meta';
import { ArrowRight, Palette, Phone, Clock, MapPin, ChevronRight, ListOrdered, Printer, CalendarCheck } from '@lucide/astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  // "/" and "/quick-quote/" have their own pages in src/pages/.
  return pages
    .filter((page) => !['/', '/quick-quote/'].includes(page.data.path))
    .map((page) => ({
      params: { slug: page.data.path.replace(/^\/|\/$/g, '') },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const { title, description, h1, noindex, imported, summary, facts, faqs, kind, path, updated } = page.data;
// Legal pages get a table of contents (sticky on desktop, collapsible on phones).
const toc = kind === 'legal' ? headings.filter((h) => h.depth === 2) : [];
const hasToc = toc.length >= 4;
const updatedLabel = updated ? new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
const url = new URL(path, business.url).toString();
const image = ['service', 'product', 'location', 'audience'].includes(kind) ? heroImage(path) : null;
const eyebrow = eyebrowFor(kind, path);
const related = relatedFor(kind);
const narrow = kind === 'blog' || kind === 'legal' || kind === 'utility';

const crumbs = path.split('/').filter(Boolean);
const crumbItems = crumbs.map((c, i) => ({
  label: i === crumbs.length - 1 ? h1 : c.replace(/-/g, ' ').replace(/^\w/, (x) => x.toUpperCase()),
  href: i === crumbs.length - 1 ? undefined : `/${crumbs.slice(0, i + 1).join('/')}/`,
}));
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
      ...crumbItems.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.label, item: `${business.url}/${crumbs.slice(0, i + 1).join('/')}/` })),
    ],
  },
];
if (kind === 'service' || kind === 'product' || kind === 'location') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: h1,
    description: summary || description,
    url,
    areaServed: path.includes('cleveland')
      ? { '@type': 'City', name: 'Cleveland', containedInPlace: { '@type': 'State', name: 'Ohio' } }
      : { '@type': 'City', name: 'Los Angeles' },
    provider: { '@id': `${business.url}/#organization` },
  });
}
const videos = PAGE_VIDEOS[path] ?? [];
for (const v of videos) { const ld = videoJsonLd(v); if (ld) jsonLd.push(ld); }
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbItems} />

  {imported && import.meta.env.DEV && (
    <p class="mb-6 rounded-xl border border-amber-500/30 bg-amber-500/10 px-4 py-2.5 text-[13px] text-amber-800 dark:text-amber-200">Imported from WordPress, not rewritten yet. (Only shown while developing.)</p>
  )}

  <section class:list={['grid gap-6 md:gap-10 items-center', image ? 'lg:grid-cols-[1.1fr_0.9fr]' : '']}>
    <div class:list={[narrow ? 'max-w-3xl' : 'max-w-2xl']}>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-2 md:mt-3 text-4xl sm:text-5xl font-extrabold leading-[1.05] text-zinc-900 dark:text-white">{h1}</h1>
      {(summary || (!narrow && description)) && <p class="mt-3 md:mt-5 text-lg leading-8 muted">{summary || description}</p>}
      {kind === 'legal' && (updatedLabel || hasToc) && (
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13.5px] muted print:hidden">
          {updatedLabel && <p class="flex items-center gap-1.5"><CalendarCheck class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Last updated <time datetime={updated}>{updatedLabel}</time></p>}
          <button type="button" data-print class="flex items-center gap-1.5 font-semibold text-violet-700 dark:text-violet-300 hover:underline"><Printer class="w-4 h-4" aria-hidden="true" />Print or save as PDF</button>
        </div>
      )}
      {facts.length > 0 && (
        <dl class="mt-4 md:mt-6 grid grid-cols-2 sm:grid-cols-3 gap-2 md:gap-3">
          {facts.map((f) => (
            <div class="panel px-4 py-3 max-md:px-3 max-md:py-2.5 max-md:rounded-xl"><dt class="text-[11px] max-md:text-[10px] font-bold uppercase tracking-[0.1em] muted">{f.label}</dt><dd class="mt-1 max-md:mt-0.5 font-bold max-md:text-[13.5px] max-md:leading-snug text-zinc-900 dark:text-white">{f.value}</dd></div>
          ))}
        </dl>
      )}
      {!narrow && (
        <div class="mt-7 max-md:mt-5 flex flex-wrap gap-3 max-md:grid max-md:grid-cols-2 max-md:gap-2">
          <a class="btn-primary max-md:px-3" href="/quick-quote/">Get a quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></a>
          {business.studioLive
            ? <a class="btn-quiet max-md:px-3" href={`${business.studioUrl}/studio`} rel="nofollow"><Palette class="w-4 h-4" aria-hidden="true" />Design it online</a>
            : <a class="btn-quiet max-md:px-3" href={`tel:${business.phone}`}><Phone class="w-4 h-4" aria-hidden="true" />{business.phoneDisplay}</a>}
        </div>
      )}
    </div>
    {image && (
      <div class="relative">
        <div class="absolute inset-6 rounded-[2rem] bg-violet-500/20 blur-3xl" aria-hidden="true"></div>
        <img src={image} alt="" width="560" height="560" class="relative w-full max-w-md max-md:max-w-[min(62vw,260px)] mx-auto aspect-square object-contain panel-raised p-6 max-md:p-4" />
      </div>
    )}
  </section>

  <div class:list={['mt-14 max-md:mt-8 grid gap-8 md:gap-10', hasToc ? 'lg:grid-cols-[260px_minmax(0,1fr)]' : narrow ? '' : 'lg:grid-cols-[minmax(0,1fr)_300px]']}>
    {hasToc && (
      <>
        <nav class="max-lg:hidden lg:sticky lg:top-36 self-start max-h-[calc(100vh-10rem)] overflow-y-auto panel p-2 print:hidden" aria-label="On this page" data-toc>
          <p class="eyebrow px-3 pt-2 pb-1 flex items-center gap-1.5"><ListOrdered class="w-4 h-4" aria-hidden="true" />On this page</p>
          {toc.map((h) => (
            <a href={`#${h.slug}`} data-toc-link={h.slug} class="block px-3 py-1.5 rounded-lg text-[13.5px] leading-snug text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-white/[0.06] aria-[current=true]:text-violet-700 dark:aria-[current=true]:text-violet-300 aria-[current=true]:bg-violet-500/10 aria-[current=true]:font-semibold">{h.text}</a>
          ))}
        </nav>
        <details class="lg:hidden panel group print:hidden" data-toc-mobile>
          <summary class="flex items-center justify-between gap-3 px-4 min-h-[52px] cursor-pointer list-none font-semibold text-zinc-900 dark:text-white [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2"><ListOrdered class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />On this page · {toc.length} sections</span>
            <ChevronRight class="w-5 h-5 text-zinc-400 transition-transform group-open:rotate-90" aria-hidden="true" />
          </summary>
          <div class="px-2 pb-2 grid">
            {toc.map((h) => <a href={`#${h.slug}`} class="px-3 min-h-[44px] flex items-center rounded-lg text-[15px] text-zinc-700 dark:text-zinc-300 active:bg-zinc-100 dark:active:bg-white/[0.06]">{h.text}</a>)}
          </div>
        </details>
      </>
    )}
    <article class:list={['prose-tb', { 'prose-legal': kind === 'legal' }]}>
      <Content />
      {hasToc && <p class="!mt-12 print:hidden"><a href="#top" data-top class="!no-underline font-semibold text-[14px]">↑ Back to top</a></p>}
    </article>
    {!narrow && (
      <aside class="space-y-4 lg:sticky lg:top-24 self-start">
        <div class="panel-raised p-5 max-md:hidden">
          <p class="eyebrow">Get a price</p>
          <p class="mt-2 text-sm muted">Send your garment, quantity and artwork. We reply within one business day.</p>
          <a class="btn-primary w-full mt-4" href="/quick-quote/">Get a quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></a>
          <div class="mt-4 space-y-2 text-[13px] muted">
            <p class="flex items-center gap-2"><Phone class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" /><a href={`tel:${business.phone}`}>{business.phoneDisplay}</a></p>
            <p class="flex items-center gap-2"><Clock class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Mon–Fri, 9am–5pm</p>
            <p class="flex items-start gap-2"><MapPin class="w-4 h-4 mt-0.5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.address.streetAddress}, Los Angeles</p>
          </div>
        </div>
        <nav class="panel p-2" aria-label={related.title}>
          <p class="eyebrow px-3 pt-2 pb-1">{related.title}</p>
          {related.links.map((l) => (
            <a href={l.href} aria-current={l.href === path ? 'page' : undefined} class="flex items-center justify-between px-3 py-2 max-md:py-0 max-md:min-h-[46px] max-md:text-[15px] max-md:active:bg-zinc-100 dark:max-md:active:bg-white/[0.06] rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-white/[0.06] aria-[current=page]:text-violet-700 dark:aria-[current=page]:text-violet-300 aria-[current=page]:bg-violet-500/10">{l.label}<ChevronRight class="w-4 h-4 text-zinc-400" aria-hidden="true" /></a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  {videos.length > 0 && <div class="mt-16"><VideoGrid videos={videos} /></div>}
  {!narrow && <div class="mt-16 empty:hidden"><RelatedProducts path={path} kind={kind} /></div>}
  {faqs.length > 0 && <div class="mt-16"><Faq faqs={faqs} /></div>}
  {!narrow && <div class="mt-16"><CtaBand /></div>}
</Base>

{hasToc && (
  <script>
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    document.querySelector('[data-top]')?.addEventListener('click', (e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    // Close the phone menu after a jump.
    const mobile = document.querySelector<HTMLDetailsElement>('[data-toc-mobile]');
    mobile?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { mobile.open = false; }));
    // Highlight the section being read.
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
    const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const mark = () => {
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.35) current = h;
      links.forEach((a, id) => a.setAttribute('aria-current', String(id === current?.id)));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  </script>
)}
