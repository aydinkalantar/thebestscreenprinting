---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AssistantWidget from '../components/AssistantWidget.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import { business, localBusinessJsonLd } from '../data/business';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** Full-bleed pages (home) manage their own width. */
  bare?: boolean;
}

const { title, description = '', noindex = false, jsonLd = [], bare = false } = Astro.props;
// Self-referencing canonical on the production host, always with a trailing slash.
const canonical = new URL(Astro.url.pathname, business.url).toString();
const schema = [localBusinessJsonLd, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
    <script is:inline>
      // App-like phones: no pinch or double-tap zoom (double-tap is handled by touch-action in
      // global.css). iOS Safari ignores maximum-scale, so block its gesture events and
      // two-finger moves too, except inside an element marked [data-zoomable].
      (() => {
        const free = (e) => e.target instanceof Element && e.target.closest('[data-zoomable]');
        const stop = (e) => { if (!free(e)) e.preventDefault(); };
        ['gesturestart', 'gesturechange', 'gestureend'].forEach((t) => document.addEventListener(t, stop, { passive: false }));
        document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) stop(e); }, { passive: false });
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="TBSP" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:image" content={new URL("/icon-512.png", business.url).toString()} />
    <link rel="icon" href="/images/brand/tbsp-favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@600;700;800&display=swap" />
    <!-- Same theme rule as the studio: a saved choice wins, otherwise follow the OS. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.add(dark ? 'dark' : 'light');
        // A saved choice can differ from the OS: point both theme-color metas at it.
        if (t) document.querySelectorAll('meta[name="theme-color"]').forEach((m) => { m.content = dark ? '#0a0a0f' : '#ffffff'; });
      } catch {}
    </script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen flex flex-col" data-home={Astro.url.pathname === '/' ? '' : undefined}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 btn-primary btn-sm z-[60]">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      {bare ? <slot /> : <div class="wrap pt-4 pb-8 md:py-14"><slot /></div>}
    </main>
    <Footer />
    <AssistantWidget />
    <MobileTabBar />
    <script is:inline>
      document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.classList.contains('dark') ? 'light' : 'dark';
        root.classList.remove('dark', 'light');
        root.classList.add(next);
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => { m.content = next === 'dark' ? '#0a0a0f' : '#ffffff'; });
        try { localStorage.setItem('theme', next); } catch {}
      }));
    </script>
  </body>
</html>
