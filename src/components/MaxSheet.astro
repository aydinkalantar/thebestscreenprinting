---
// Max, your merch agent (phones: full-height bottom sheet; md+: a panel on the right).
// Opened through openMax() in src/lib/max.ts. The conversation runs in src/lib/max-chat.ts against
// the studio (/api/public/max); when that can't be reached, a message goes to the quote form instead.
import { business } from '../data/business';
// Checkout lives here so Max (and every page) can open it.
import OrderSheet from './design/OrderSheet.astro';
import { X, ArrowUp, Phone, MessageSquareText, Mail, Sparkles, Paperclip, RotateCcw, Mic, Square, Volume2, VolumeX } from '@lucide/astro';
const starters = [
  '50 black tees with our logo',
  'Hoodies for my team of 20',
  'I need shirts by next Friday',
  'Check my logo for printing',
];
const contact = 'press inline-flex items-center gap-1.5 h-9 px-3 rounded-full border border-zinc-200 dark:border-white/10 text-[13px] font-semibold text-zinc-800 dark:text-zinc-100 hover:border-violet-300';
---
<!-- Desktop: Max is one click away on every page (phones use the tab bar's orb). -->
<button type="button" data-max-open data-max-fab data-max-only class="hidden md:flex fixed bottom-6 right-6 z-[50] items-center gap-2.5 h-12 pl-1.5 pr-4 rounded-full bg-white dark:bg-[#15151d] border border-zinc-200 dark:border-white/10 shadow-xl hover:shadow-2xl transition-shadow print:hidden">
  <span class="max-orb relative w-9 h-9" aria-hidden="true"><Sparkles class="w-4 h-4" /></span>
  <span class="text-[14px] font-semibold text-zinc-900 dark:text-white">Ask Max</span>
</button>

<div data-max-sheet data-sheet="modal" hidden role="dialog" aria-modal="true" aria-labelledby="max-title" class="fixed inset-0 z-[96]">
  <div class="absolute inset-0 bg-black/40 md:bg-black/20" data-sheet-backdrop data-sheet-close></div>
  <div data-sheet-panel class="absolute inset-x-0 bottom-0 top-[calc(env(safe-area-inset-top)+12px)] flex flex-col rounded-t-3xl bg-white dark:bg-[#0d0d14] shadow-2xl md:inset-y-3 md:right-3 md:left-auto md:top-3 md:w-[440px] md:rounded-3xl">
    <div data-sheet-grip class="shrink-0 px-4 pt-2 pb-3 border-b border-zinc-200/80 dark:border-white/10">
      <span class="block mx-auto w-10 h-1.5 rounded-full bg-zinc-300 dark:bg-white/20 md:hidden" aria-hidden="true"></span>
      <div class="mt-2 flex items-center gap-3">
        <span class="max-orb relative w-10 h-10 shrink-0" aria-hidden="true"><Sparkles class="w-5 h-5" /></span>
        <div class="min-w-0 flex-1 leading-tight">
          <p id="max-title" class="text-[17px] font-bold text-zinc-900 dark:text-white">Max</p>
          <p class="text-[12.5px] muted">Your merch agent · picks, prices and plans your order</p>
        </div>
        <button type="button" data-max-speak hidden aria-pressed="false" class="icon-btn w-10 h-10 rounded-xl shrink-0" aria-label="Read Max's replies aloud" title="Read replies aloud">
          <Volume2 data-on hidden class="w-[18px] h-[18px] text-violet-600 dark:text-violet-300" aria-hidden="true" /><VolumeX data-off class="w-[18px] h-[18px]" aria-hidden="true" />
        </button>
        <button type="button" data-max-reset hidden class="icon-btn w-10 h-10 rounded-xl shrink-0" aria-label="Start over" title="Start over"><RotateCcw class="w-4 h-4" aria-hidden="true" /></button>
        <button type="button" class="icon-btn w-10 h-10 rounded-xl shrink-0" data-sheet-close aria-label="Close"><X class="w-[18px] h-[18px]" aria-hidden="true" /></button>
      </div>
    </div>

    <div data-max-log class="flex-1 overflow-y-auto overscroll-contain px-4 py-4 grid gap-3 content-start" aria-live="polite">
      <!-- Shown until the first message. -->
      <div data-max-intro class="grid gap-4">
        <div data-max-greeting class="max-bubble max-bot">Hi, I'm Max. Tell me what you need, like the product, how many and when, and I'll put together your order with real prices. You can also send me your logo and I'll check it.</div>
        <div data-max-starters class="flex flex-wrap gap-2">
          {starters.map((s) => <button type="button" data-max-starter data-max-logo={/^check my logo/i.test(s) ? '' : undefined} class="chip !h-auto py-2 text-left text-[13.5px]">{s}</button>)}
        </div>
        <div class="flex flex-wrap gap-2 pt-1">
          <a href={`tel:${business.phone}`} class={contact}><Phone class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Call</a>
          <a href={`sms:${business.phone}`} class={contact}><MessageSquareText class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Text</a>
          <a href={`mailto:${business.email}`} class={contact}><Mail class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Email</a>
        </div>
      </div>
    </div>

    <form data-max-form class="shrink-0 border-t border-zinc-200/80 dark:border-white/10 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
      <div data-max-files hidden class="mb-2 flex flex-wrap gap-2"></div>
      <p data-max-listening hidden class="mb-2 flex items-center gap-2 text-[13px] font-semibold text-rose-600 dark:text-rose-400" aria-live="polite"><span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse" aria-hidden="true"></span><span data-max-listening-text>Listening… speak now</span></p>
      <div class="flex items-end gap-2">
        <button type="button" data-max-attach class="icon-btn w-11 h-11 rounded-xl shrink-0" aria-label="Send Max your logo" title="Send your logo"><Paperclip class="w-[18px] h-[18px]" aria-hidden="true" /></button>
        <button type="button" data-max-mic hidden class="icon-btn w-11 h-11 rounded-xl shrink-0" aria-label="Talk to Max" title="Talk to Max">
          <Mic data-idle class="w-[18px] h-[18px]" aria-hidden="true" /><Square data-stop hidden class="w-4 h-4 fill-current" aria-hidden="true" />
        </button>
        <label for="max-input" class="sr-only">Message Max</label>
        <textarea id="max-input" name="details" rows="1" maxlength="1000" enterkeyhint="send" class="field !text-base resize-none !py-2.5 max-h-36" placeholder="Message Max…"></textarea>
        <button type="submit" data-max-send class="btn-primary w-11 h-11 !p-0 rounded-xl shrink-0 disabled:opacity-50" aria-label="Send"><ArrowUp class="w-5 h-5" aria-hidden="true" /></button>
      </div>
      <input type="file" data-max-file class="sr-only" tabindex="-1" aria-hidden="true" accept="image/*,.pdf,.ai,.psd,.svg" />
    </form>
  </div>
</div>

<OrderSheet />

<style is:global>
  [data-max-sheet] [hidden] { display: none !important; }
  .max-bubble { max-width: 88%; padding: 0.6rem 0.85rem; border-radius: 1.1rem; font-size: 14.5px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
  .max-bot { justify-self: start; background: rgb(244 244 245); color: rgb(24 24 27); border-bottom-left-radius: 0.35rem; }
  .max-me { justify-self: end; background: rgb(124 58 237); color: #fff; border-bottom-right-radius: 0.35rem; }
  .dark .max-bot { background: rgba(255,255,255,0.07); color: rgb(244 244 245); }
  [data-max-mic].is-on { background: rgb(225 29 72); color: #fff; border-color: transparent; box-shadow: 0 0 0 4px rgba(225,29,72,0.2); }
  .max-typing span { display: inline-block; width: 6px; height: 6px; margin: 0 2px; border-radius: 9999px; background: currentColor; opacity: 0.4; animation: max-dot 1s infinite; }
  .max-typing span:nth-child(2) { animation-delay: 0.15s; } .max-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes max-dot { 50% { opacity: 1; transform: translateY(-2px); } }
</style>

<script>
  import '../lib/max';
  import '../lib/max-chat';
</script>
