---
// Phone-only bottom tab bar, like a native shopping app. Hidden from md up.
// Home · Products · Max (center orb) · Search · Quote. The orb opens Max via
// openMax() in src/lib/max.ts; Search opens the header's search sheet
// ([data-search-open] is wired in Header.astro). The phone number stays in the
// header menu, the footer, product pages and Max's sheet.
import MaxSheet from './MaxSheet.astro';
import { House, Shirt, Search, ClipboardPen, Sparkles } from '@lucide/astro';
const here = Astro.url.pathname;
// Product pages have their own action bar (with Max) instead of the tab bar.
const productPage = /^\/catalog\/(?!brand\/|category\/)[^/]+\/?$/.test(here);
const active = here === '/' ? 'home' : here.startsWith('/catalog/') ? 'products' : here.startsWith('/quick-quote/') || here.startsWith('/quote-cart/') ? 'quote' : '';
const item = 'press flex flex-col items-center justify-center gap-0.5 min-w-0 h-[60px] text-[10.5px] font-semibold tracking-tight';
const tone = (on: boolean) => on ? 'text-violet-700 dark:text-violet-300' : 'text-zinc-500 dark:text-zinc-400';
---
{!productPage && <nav data-tabbar aria-label="Quick links"
  class="md:hidden fixed inset-x-0 bottom-0 z-[60] border-t border-zinc-200/80 dark:border-white/10 bg-white/80 dark:bg-[#0a0a0f]/80 backdrop-blur-xl backdrop-saturate-150 pb-[env(safe-area-inset-bottom)]">
  <ul class="grid grid-cols-5 px-1">
    <li><a href="/" class:list={[item, tone(active === 'home')]} aria-current={active === 'home' ? 'page' : undefined}><span class="h-7 grid place-items-center"><House class="w-[22px] h-[22px]" aria-hidden="true" /></span>Home</a></li>
    <li><a href="/catalog/" class:list={[item, tone(active === 'products')]} aria-current={active === 'products' ? 'page' : undefined}><span class="h-7 grid place-items-center"><Shirt class="w-[22px] h-[22px]" aria-hidden="true" /></span>Products</a></li>
    <li class="relative">
      <a href="/quick-quote/" data-max-open aria-haspopup="dialog" class="press flex flex-col items-center justify-end w-full min-w-0 h-[60px] pb-[7px] text-[10.5px] font-semibold tracking-tight text-violet-700 dark:text-violet-300">
        <span class="max-orb absolute left-[calc(50%-27px)] -top-[24px] w-[54px] h-[54px] outline outline-4 outline-white dark:outline-[#0a0a0f]" aria-hidden="true"><Sparkles class="w-6 h-6" /></span>
        Max
      </a>
    </li>
    <li><button type="button" data-search-open aria-haspopup="dialog" class:list={[item, tone(false), 'w-full']}><span class="h-7 grid place-items-center"><Search class="w-[22px] h-[22px]" aria-hidden="true" /></span>Search</button></li>
    <li><a href="/quick-quote/" data-cart-tab class:list={[item, tone(active === 'quote')]} aria-current={active === 'quote' ? 'page' : undefined}><span class="relative h-7 grid place-items-center"><ClipboardPen class="w-[22px] h-[22px]" aria-hidden="true" /><span data-cart-count hidden class="absolute -top-0.5 -right-2.5 min-w-[18px] h-[18px] px-1 rounded-full bg-violet-600 text-white text-[10.5px] font-bold leading-[18px] text-center ring-2 ring-white dark:ring-[#0a0a0f]" aria-hidden="true">0</span></span>Quote</a></li>
  </ul>
</nav>}
<MaxSheet />
