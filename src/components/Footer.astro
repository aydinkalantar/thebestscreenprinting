---
import BrandMark from './BrandMark.astro';
import { business } from '../data/business';
import { VIDEOS } from '../data/videos';
import { Phone, Mail, Sparkles, MapPin, Play } from '@lucide/astro';
import { collectionHref } from '../lib/catalog';

const about: [string, string][] = [
  ['About TBSP', '/about-us/'], ['Los Angeles facility', '/los-angeles-ca/'], ['Cleveland facility', '/cleveland-oh/'],
  ['Who we print for', '/solutions/'], ['Guides & articles', '/blog/'], ['Watch us print', 'https://www.youtube.com/@Thebestscreenprinting'],
];
const service: [string, string][] = [
  ['Get a quote', '/quick-quote/'], ['Help center', '/help-center/'], ['FAQ', '/faq/'], ['Turnaround options', '/learn-delivery-time/'],
  ['Shipping & delivery', '/shipping-and-delivery/'], ['Design tips', '/helpful-design-tips/'],
];
const shop: [string, string][] = [
  ['T-shirts', collectionHref('t-shirts')], ['Hoodies', collectionHref('hoodies')], ['Hats & caps', collectionHref('hats')],
  ['Polos', collectionHref('polos')], ['Bags & totes', collectionHref('bags')], ['All products', '/catalog/'],
];
const account: [string, string][] = business.studioLive
  ? [['Sign in', `${business.studioUrl}/login`], ['Track your order', `${business.studioUrl}/orders`], ['Saved designs', `${business.studioUrl}/studio`]]
  : [['Custom projects', '/custom-projects/'], ['Rush & Super Rush', '/same-day-t-shirt-printing-los-angeles/']];
const social: [string, string][] = [
  ['Instagram', 'https://www.instagram.com/tbsp.la/'], ['YouTube', 'https://www.youtube.com/c/Thebestscreenprinting'],
  ['Facebook', 'https://www.facebook.com/TheBestScreenPrinting/'], ['Yelp', 'https://www.yelp.com/biz/the-best-screen-printing-and-embroidery-los-angeles-2'],
];
const reel = VIDEOS.reel;
const col = 'text-[15px] text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white';
---
<footer class="mt-16 md:mt-24 border-t-4 border-zinc-900 dark:border-white/20 bg-white dark:bg-[#0a0a0f]">
  <div class="wrap py-10 md:py-14 grid gap-8 md:gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[1.4fr_1fr_1fr_1.1fr]">
    <div class="space-y-6">
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Watch us print</p>
        <a href={`https://www.youtube.com/watch?v=${reel.id}`} rel="noopener" class="group relative block max-w-sm aspect-video rounded-2xl overflow-hidden bg-zinc-900">
          <img src={`https://i.ytimg.com/vi/${reel.id}/hqdefault.jpg`} alt={reel.title} loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100" />
          <span class="absolute inset-0 grid place-items-center"><span class="w-14 h-14 rounded-full bg-violet-600 text-white grid place-items-center"><Play class="w-6 h-6 ml-0.5" aria-hidden="true" /></span></span>
        </a>
      </div>
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Follow us</p>
        <div class="flex flex-wrap gap-2">{social.map(([l, h]) => <a class="chip !h-8 !px-3 !text-xs" href={h} rel="noopener">{l}</a>)}</div>
      </div>
    </div>
    <div class="space-y-8">
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">About us</p>
        <ul class="space-y-2">{about.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </div>
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">{business.studioLive ? 'Your account' : 'Custom orders'}</p>
        <ul class="space-y-2">{account.map(([l, h]) => <li><a class={col} href={h} rel={h.startsWith('http') ? 'nofollow' : undefined}>{l}</a></li>)}</ul>
      </div>
    </div>
    <div class="space-y-8">
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Shop</p>
        <ul class="space-y-2">{shop.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </div>
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Service center</p>
        <ul class="space-y-2">{service.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </div>
    </div>
    <div class="space-y-5">
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Contact us</p>
        <p class="text-[15px] muted">Monday–Friday: 9am – 5pm PT</p>
      </div>
      <ul class="space-y-3 text-[15px]">
        <li><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href={`tel:${business.phone}`}><Phone class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.phoneDisplay}</a></li>
        <li><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href="/quick-quote/" data-ask-ai><Sparkles class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.studioLive ? 'Ask Max' : 'Get a quote'}</a></li>
        <li><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href={`mailto:${business.email}`}><Mail class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.email}</a></li>
        <li class="flex items-start gap-3 text-zinc-800 dark:text-zinc-200"><MapPin class="w-5 h-5 mt-0.5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><span>{business.address.streetAddress}, {business.address.addressLocality}, {business.address.addressRegion} {business.address.postalCode}<br /><span class="muted">and Cleveland, Ohio</span></span></li>
      </ul>
    </div>
  </div>
  <div class="bg-zinc-100 dark:bg-white/[0.04]">
    <div class="wrap py-5 flex flex-wrap items-center justify-between gap-3 text-[13px] muted">
      <span class="flex items-center gap-3"><BrandMark size="sm" />© {new Date().getFullYear()} {business.name}</span>
      <span class="flex flex-wrap gap-4"><a href="/privacy-policy/">Privacy policy</a><a href="/terms-conditions/">Terms</a><a href="/catalog/">Custom products</a></span>
    </div>
  </div>
</footer>
