---
import BrandMark from './BrandMark.astro';
import { business } from '../data/business';
import { Phone, Mail, MapPin, Play, ChevronDown, ClipboardPen, Star, Clock, ArrowUp, ArrowRight, Navigation, Truck, Moon, Sun } from '@lucide/astro';
import { collectionHref } from '../lib/catalog';

type Link = [string, string];
const groups: { title: string; links: Link[] }[] = [
  {
    title: 'Shop',
    links: [
      ['T-shirts', collectionHref('t-shirts')], ['Hoodies & sweatshirts', collectionHref('hoodies')], ['Hats & caps', collectionHref('hats')],
      ['Polos', collectionHref('polos')], ['Bags & totes', collectionHref('bags')], ['All products', '/catalog/'],
    ],
  },
  {
    title: 'Services',
    links: [
      ['Screen printing', '/screen-printing/'], ['Embroidery', '/services/embroidery/'], ['DTG printing', '/services/direct-to-garment/'],
      ['DTF transfers', '/services/direct-to-film/'], ['Heat transfer vinyl', '/services/heat-transfer-vinyl/'], ['Embossing', '/services/embossing/'],
      ['Custom projects', '/custom-projects/'],
    ],
  },
  {
    title: 'Help',
    links: [
      ['Get a free quote', '/quick-quote/'], ['Your cart', '/quote-cart/'], ['Track my order', '/track/'], ['Help center', '/help-center/'], ['FAQ', '/faq/'],
      ['Turnaround & Rush', '/learn-delivery-time/'], ['Shipping & delivery', '/shipping-and-delivery/'], ['Artwork & design tips', '/helpful-design-tips/'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['About TBSP', '/about-us/'], ['Who we print for', '/solutions/'], ['Fulfillment', '/fulfillment/'], ['Los Angeles shop', '/los-angeles-ca/'],
      ['Cleveland shop', '/cleveland-oh/'], ['Guides & articles', '/blog/'],
    ],
  },
];
const social: Link[] = [
  ['Instagram', 'https://www.instagram.com/tbsp.la/'], ['YouTube', 'https://www.youtube.com/c/Thebestscreenprinting'],
  ['Facebook', 'https://www.facebook.com/TheBestScreenPrinting/'], ['Yelp', 'https://www.yelp.com/biz/the-best-screen-printing-and-embroidery-los-angeles-2'],
];
const a = business.address;
const street = `${a.streetAddress}, ${a.addressLocality}, ${a.addressRegion} ${a.postalCode}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${business.name}, ${street}`)}`;
const year = new Date().getFullYear();

const link = 'text-[14.5px] text-zinc-600 dark:text-zinc-400 hover:text-violet-700 dark:hover:text-violet-300 transition-colors max-md:flex max-md:items-center max-md:min-h-[44px] max-md:text-[15px] max-md:active:text-zinc-900 dark:max-md:active:text-white';
// Link groups: plain lists from md up; on phones each is a collapsible row (closed by the script below).
const sum = 'block text-[13px] font-bold uppercase tracking-[0.08em] text-zinc-900 dark:text-white mb-4 max-md:mb-0 max-md:normal-case max-md:tracking-normal max-md:flex max-md:items-center max-md:justify-between max-md:min-h-[52px] max-md:text-[15px] md:cursor-auto select-none';
const quiet = 'press inline-flex items-center gap-2 h-11 px-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.04] text-[14px] font-semibold text-zinc-900 dark:text-white hover:border-zinc-300 dark:hover:border-white/20';
// Simple social glyphs (Lucide has no brand icons).
const glyph: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/>',
  YouTube: '<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>',
  Facebook: '<path d="M14 8h2.5V4.5H14a4 4 0 0 0-4 4V11H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3V8.8c0-.5.3-.8.5-.8z" fill="currentColor"/>',
};
---
<footer class="mt-10 md:mt-24 border-t border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-[#0a0a0f] print:hidden">
  <!-- Desktop: talk to us strip -->
  <div class="max-md:hidden border-b border-zinc-200 dark:border-white/10">
    <div class="wrap py-8 flex flex-wrap items-center justify-between gap-6">
      <div>
        <p class="text-xl font-bold text-zinc-900 dark:text-white">Questions? Talk to a real person.</p>
        <p class="mt-1 flex items-center gap-2 text-[14px] muted"><Clock class="w-4 h-4" aria-hidden="true" />Monday–Friday, 9am–5pm PT · We reply to every quote within one business day</p>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <a href={`tel:${business.phone}`} class={quiet}><Phone class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.phoneDisplay}</a>
        <a href={`mailto:${business.email}`} class={quiet}><Mail class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.email}</a>
        <a href="/quick-quote/" class="btn-primary h-11">Get a free quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></a>
      </div>
    </div>
  </div>

  <!-- Phones: brand, the three ways to reach us, social (below) -->
  <div class="md:hidden wrap pt-6 pb-5">
    <div class="flex items-center gap-3">
      <BrandMark size="sm" />
      <p class="text-[13.5px] leading-snug muted">Printed in-house in Los Angeles and Cleveland. Mon–Fri, 9am–5pm PT.</p>
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2">
      <a href={`tel:${business.phone}`} class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.04] text-[13px] font-semibold text-zinc-900 dark:text-white active:bg-zinc-100 dark:active:bg-white/[0.08]" aria-label={`Call ${business.phoneDisplay}`}><Phone class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />Call</a>
      <a href="/quick-quote/" class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl bg-violet-600 text-[13px] font-semibold text-white shadow-[0_12px_30px_-14px_rgba(124,58,237,0.7)] active:bg-violet-700"><ClipboardPen class="w-5 h-5" aria-hidden="true" />Get a quote</a>
      <a href={`mailto:${business.email}`} class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.04] text-[13px] font-semibold text-zinc-900 dark:text-white active:bg-zinc-100 dark:active:bg-white/[0.08]" aria-label={`Email ${business.email}`}><Mail class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />Email</a>
    </div>
  </div>

  <div class="wrap md:pt-14 md:pb-12 grid gap-0 md:gap-10 grid-cols-[minmax(0,1fr)] md:grid-cols-4 lg:grid-cols-[1.35fr_repeat(4,minmax(0,1fr))]">
    <!-- Brand -->
    <div class="max-md:hidden md:col-span-4 lg:col-span-1 lg:pr-6">
      <div class="flex items-center gap-3">
        <BrandMark />
        <span class="leading-tight"><span class="block text-lg font-bold text-zinc-900 dark:text-white">TBSP</span><span class="block text-[13px] muted">{business.name}</span></span>
      </div>
      <p class="mt-4 text-[14.5px] leading-6 muted max-w-sm">Screen printing, embroidery, DTG and more for brands, businesses, teams and events. Everything is made in our own shops in Los Angeles and Cleveland. Orders start at {business.shopMinimum} pieces.</p>
      <div class="mt-5 flex items-center gap-2" aria-label="Follow us">
        {social.map(([l, h]) => (
          <a href={h} rel="noopener" target="_blank" aria-label={`${l} (opens in a new tab)`} title={l} class="press w-10 h-10 grid place-items-center rounded-full border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.04] text-zinc-700 dark:text-zinc-200 hover:text-violet-700 dark:hover:text-violet-300 hover:border-violet-300 dark:hover:border-violet-400/40">
            {glyph[l] ? <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" aria-hidden="true" set:html={glyph[l]} /> : <Star class="w-[18px] h-[18px]" aria-hidden="true" />}
          </a>
        ))}
      </div>
      <a href="https://www.youtube.com/@Thebestscreenprinting" rel="noopener" target="_blank" class="mt-5 inline-flex items-center gap-2 text-[14px] font-semibold text-violet-700 dark:text-violet-300 hover:underline underline-offset-2">
        <span class="w-7 h-7 rounded-full bg-violet-600 text-white grid place-items-center"><Play class="w-3.5 h-3.5 ml-0.5" aria-hidden="true" /></span>Watch us print on YouTube
      </a>
    </div>

    <!-- Link groups -->
    {groups.map((g, i) => (
      <details open data-fgroup class:list={['max-md:border-b max-md:border-zinc-200/80 dark:max-md:border-white/10', { 'max-md:border-t': i === 0 }]}>
        <summary class={sum}>{g.title}<ChevronDown class="chev md:hidden w-5 h-5 text-zinc-400 transition-transform" aria-hidden="true" /></summary>
        <ul class="space-y-2.5 max-md:space-y-0 max-md:pb-2 max-md:-mt-1">{g.links.map(([l, h]) => <li><a class={link} href={h}>{l}</a></li>)}</ul>
      </details>
    ))}
  </div>

  <!-- Locations -->
  <div class="wrap pb-6 md:pb-10 max-md:pt-5">
    <div class="md:hidden mb-5 flex items-center justify-between gap-3">
      <p class="font-bold text-[15px] text-zinc-900 dark:text-white">Follow us</p>
      <div class="flex items-center gap-2">
        {social.map(([l, h]) => (
          <a href={h} rel="noopener" target="_blank" aria-label={`${l} (opens in a new tab)`} class="press w-11 h-11 grid place-items-center rounded-full border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.04] text-zinc-700 dark:text-zinc-200 active:bg-zinc-100 dark:active:bg-white/[0.08]">
            {glyph[l] ? <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true" set:html={glyph[l]} /> : <Star class="w-5 h-5" aria-hidden="true" />}
          </a>
        ))}
      </div>
    </div>
    <p class="md:hidden font-bold text-[15px] text-zinc-900 dark:text-white mb-3">Our shops</p>
    <div class="grid gap-3 md:grid-cols-2">
      <div class="panel p-4 md:p-5 flex gap-3.5 bg-white dark:bg-white/[0.03]">
        <span class="w-10 h-10 shrink-0 rounded-xl grid place-items-center bg-violet-500/10 text-violet-600 dark:text-violet-300"><MapPin class="w-5 h-5" aria-hidden="true" /></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-zinc-900 dark:text-white"><a href="/los-angeles-ca/" class="hover:underline underline-offset-2">Los Angeles, CA</a></p>
          <p class="mt-0.5 text-[14px] muted">{street}</p>
          <p class="mt-0.5 text-[13px] muted">Shop and pickup · Mon–Fri, 9am–5pm</p>
        </div>
        <a href={directions} rel="noopener" target="_blank" class="self-center shrink-0 inline-flex items-center gap-1.5 h-10 px-3.5 rounded-xl border border-zinc-200 dark:border-white/10 text-[13.5px] font-semibold text-zinc-900 dark:text-white hover:border-violet-300 dark:hover:border-violet-400/40"><Navigation class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" /><span class="max-[420px]:sr-only">Directions</span></a>
      </div>
      <div class="panel p-4 md:p-5 flex gap-3.5 bg-white dark:bg-white/[0.03]">
        <span class="w-10 h-10 shrink-0 rounded-xl grid place-items-center bg-violet-500/10 text-violet-600 dark:text-violet-300"><Truck class="w-5 h-5" aria-hidden="true" /></span>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-zinc-900 dark:text-white"><a href="/cleveland-oh/" class="hover:underline underline-offset-2">Cleveland, OH</a></p>
          <p class="mt-0.5 text-[14px] muted">Production facility with local delivery</p>
          <p class="mt-0.5 text-[13px] muted">No storefront · reach us by phone or email</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.02]">
    <div class="wrap py-5 max-md:py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-[13px] muted">
      <span class="flex items-center gap-3"><span class="max-md:hidden"><BrandMark size="sm" /></span><span>© {year} {business.name}. All rights reserved. <span class="whitespace-nowrap">By <a href="https://aydinkalantar.com/" target="_blank" rel="noopener" class="font-semibold text-zinc-700 dark:text-zinc-200 hover:text-violet-700 dark:hover:text-violet-300">Aydin Kalantar</a></span></span></span>
      <nav aria-label="Legal" class="flex flex-wrap items-center gap-x-5 gap-y-1 max-md:gap-x-0 max-md:-mx-2">
        <a class="hover:text-zinc-900 dark:hover:text-white max-md:px-2 max-md:py-2.5" href="/privacy-policy/">Privacy policy</a>
        <a class="hover:text-zinc-900 dark:hover:text-white max-md:px-2 max-md:py-2.5" href="/terms-conditions/">Terms & conditions</a>
        <a class="hover:text-zinc-900 dark:hover:text-white max-md:px-2 max-md:py-2.5" href="/catalog/">Product catalog</a>
        <button type="button" class="theme-toggle inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-white max-md:px-2 max-md:py-2.5" aria-label="Switch light or dark mode" data-theme-toggle><Moon class="w-4 h-4 moon" aria-hidden="true" /><Sun class="w-4 h-4 sun" aria-hidden="true" /><span class="moon">Dark mode</span><span class="sun">Light mode</span></button>
        <a href="#top" data-to-top class="inline-flex items-center gap-1.5 font-semibold text-zinc-700 dark:text-zinc-200 hover:text-violet-700 dark:hover:text-violet-300 max-md:px-2 max-md:py-2.5"><ArrowUp class="w-4 h-4" aria-hidden="true" />Back to top</a>
      </nav>
    </div>
  </div>
</footer>
<script is:inline>
  // Phones: footer link groups start collapsed. From md up they are plain, always-open lists.
  (() => {
    const mq = matchMedia('(max-width: 767px)');
    const groups = document.querySelectorAll('[data-fgroup]');
    const set = () => groups.forEach((d) => { d.open = !mq.matches; });
    set();
    mq.addEventListener('change', set);
    groups.forEach((d) => d.querySelector('summary').addEventListener('click', (e) => { if (!mq.matches) e.preventDefault(); }));
    document.querySelector('[data-to-top]')?.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
  })();
</script>
