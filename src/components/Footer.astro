---
import BrandMark from './BrandMark.astro';
import { business } from '../data/business';
import { VIDEOS } from '../data/videos';
import { Phone, Mail, Sparkles, MapPin, Play, ChevronDown, ClipboardPen, Star } from '@lucide/astro';
import { collectionHref } from '../lib/catalog';

const about: [string, string][] = [
  ['About TBSP', '/about-us/'], ['Los Angeles facility', '/los-angeles-ca/'], ['Cleveland facility', '/cleveland-oh/'],
  ['Who we print for', '/solutions/'], ['Guides & articles', '/blog/'], ['Watch us print', 'https://www.youtube.com/@Thebestscreenprinting'],
];
const service: [string, string][] = [
  ['Get a quote', '/quick-quote/'], ['Help center', '/help-center/'], ['FAQ', '/faq/'], ['Turnaround options', '/learn-delivery-time/'],
  ['Shipping & delivery', '/shipping-and-delivery/'], ['Design tips', '/helpful-design-tips/'],
];
const shop: [string, string][] = [
  ['T-shirts', collectionHref('t-shirts')], ['Hoodies', collectionHref('hoodies')], ['Hats & caps', collectionHref('hats')],
  ['Polos', collectionHref('polos')], ['Bags & totes', collectionHref('bags')], ['All products', '/catalog/'],
];
const account: [string, string][] = business.studioLive
  ? [['Sign in', `${business.studioUrl}/login`], ['Track your order', `${business.studioUrl}/orders`], ['Saved designs', `${business.studioUrl}/studio`]]
  : [['Custom projects', '/custom-projects/'], ['Rush & Super Rush', '/same-day-t-shirt-printing-los-angeles/']];
const social: [string, string][] = [
  ['Instagram', 'https://www.instagram.com/tbsp.la/'], ['YouTube', 'https://www.youtube.com/c/Thebestscreenprinting'],
  ['Facebook', 'https://www.facebook.com/TheBestScreenPrinting/'], ['Yelp', 'https://www.yelp.com/biz/the-best-screen-printing-and-embroidery-los-angeles-2'],
];
const reel = VIDEOS.reel;
const col = 'text-[15px] text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white max-md:flex max-md:items-center max-md:min-h-[44px] max-md:active:text-zinc-900 dark:max-md:active:text-white';
// Link groups: plain lists from md up; on phones each is a collapsible row (closed by the script below).
const sum = 'block font-bold text-zinc-900 dark:text-white mb-3 max-md:mb-0 max-md:flex max-md:items-center max-md:justify-between max-md:min-h-[52px] max-md:text-[15px] md:cursor-auto select-none';
const grp = 'max-md:border-b max-md:border-zinc-200/80 dark:max-md:border-white/10';
const list = 'space-y-2 max-md:space-y-0 max-md:pb-2 max-md:-mt-1';
// Simple social glyphs (Lucide has no brand icons).
const glyph: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/>',
  YouTube: '<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>',
  Facebook: '<path d="M14 8h2.5V4.5H14a4 4 0 0 0-4 4V11H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3V8.8c0-.5.3-.8.5-.8z" fill="currentColor"/>',
};
---
<footer class="mt-10 md:mt-24 border-t-4 border-zinc-900 dark:border-white/20 bg-white dark:bg-[#0a0a0f]">
  <!-- Phones: brand, one line, the three ways to reach us, social -->
  <div class="md:hidden wrap pt-6 pb-5">
    <div class="flex items-center gap-3">
      <BrandMark size="sm" />
      <p class="text-[13.5px] leading-snug muted">Printed in-house in Los Angeles and Cleveland.</p>
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2">
      <a href={`tel:${business.phone}`} class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/[0.04] text-[13px] font-semibold text-zinc-900 dark:text-white active:bg-zinc-100 dark:active:bg-white/[0.08]" aria-label={`Call ${business.phoneDisplay}`}><Phone class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />Call</a>
      <a href="/quick-quote/" class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl bg-violet-600 text-[13px] font-semibold text-white shadow-[0_12px_30px_-14px_rgba(124,58,237,0.7)] active:bg-violet-700"><ClipboardPen class="w-5 h-5" aria-hidden="true" />Get a quote</a>
      <a href={`mailto:${business.email}`} class="press flex flex-col items-center justify-center gap-1 h-16 rounded-2xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/[0.04] text-[13px] font-semibold text-zinc-900 dark:text-white active:bg-zinc-100 dark:active:bg-white/[0.08]" aria-label={`Email ${business.email}`}><Mail class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />Email</a>
    </div>
    <div class="mt-4 flex items-center gap-2" aria-label="Follow us">
      {social.map(([l, h]) => (
        <a href={h} rel="noopener" aria-label={l} class="press w-11 h-11 grid place-items-center rounded-full border border-zinc-200 dark:border-white/10 text-zinc-700 dark:text-zinc-200 active:bg-zinc-100 dark:active:bg-white/[0.08]">
          {glyph[l] ? <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true" set:html={glyph[l]} /> : <Star class="w-5 h-5" aria-hidden="true" />}
        </a>
      ))}
    </div>
  </div>
  <div class="wrap pt-0 pb-6 md:py-14 grid gap-0 md:gap-10 grid-cols-[minmax(0,1fr)] lg:grid-cols-[1.4fr_1fr_1fr_1.1fr]">
    <div class="space-y-6 max-md:hidden">
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Watch us print</p>
        <a href={`https://www.youtube.com/watch?v=${reel.id}`} rel="noopener" class="group relative block max-w-sm aspect-video rounded-2xl overflow-hidden bg-zinc-900">
          <img src={`https://i.ytimg.com/vi/${reel.id}/hqdefault.jpg`} alt={reel.title} loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100" />
          <span class="absolute inset-0 grid place-items-center"><span class="w-14 h-14 rounded-full bg-violet-600 text-white grid place-items-center"><Play class="w-6 h-6 ml-0.5" aria-hidden="true" /></span></span>
        </a>
      </div>
      <div>
        <p class="font-bold text-zinc-900 dark:text-white mb-3">Follow us</p>
        <div class="flex flex-wrap gap-2">{social.map(([l, h]) => <a class="chip !h-8 !px-3 !text-xs" href={h} rel="noopener">{l}</a>)}</div>
      </div>
    </div>
    <div class="space-y-8 max-md:space-y-0 max-md:border-t max-md:border-zinc-200/80 dark:max-md:border-white/10">
      <details open data-fgroup class={grp}>
        <summary class={sum}>About us<ChevronDown class="chev md:hidden w-5 h-5 text-zinc-400 transition-transform" aria-hidden="true" /></summary>
        <ul class={list}>{about.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </details>
      <details open data-fgroup class={grp}>
        <summary class={sum}>{business.studioLive ? 'Your account' : 'Custom orders'}<ChevronDown class="chev md:hidden w-5 h-5 text-zinc-400 transition-transform" aria-hidden="true" /></summary>
        <ul class={list}>{account.map(([l, h]) => <li><a class={col} href={h} rel={h.startsWith('http') ? 'nofollow' : undefined}>{l}</a></li>)}</ul>
      </details>
    </div>
    <div class="space-y-8 max-md:space-y-0">
      <details open data-fgroup class={grp}>
        <summary class={sum}>Shop<ChevronDown class="chev md:hidden w-5 h-5 text-zinc-400 transition-transform" aria-hidden="true" /></summary>
        <ul class={list}>{shop.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </details>
      <details open data-fgroup class={grp}>
        <summary class={sum}>Service center<ChevronDown class="chev md:hidden w-5 h-5 text-zinc-400 transition-transform" aria-hidden="true" /></summary>
        <ul class={list}>{service.map(([l, h]) => <li><a class={col} href={h}>{l}</a></li>)}</ul>
      </details>
    </div>
    <div class="space-y-5 max-md:space-y-2 max-md:pt-5">
      <div class="max-md:flex max-md:items-baseline max-md:justify-between max-md:gap-3">
        <p class="font-bold text-zinc-900 dark:text-white mb-3 max-md:mb-0 max-md:text-[15px]">Contact us</p>
        <p class="text-[15px] max-md:text-[13px] muted">Monday–Friday: 9am – 5pm PT</p>
      </div>
      <ul class="space-y-3 text-[15px] max-md:text-[13.5px]">
        <li class="max-md:hidden"><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href={`tel:${business.phone}`}><Phone class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.phoneDisplay}</a></li>
        <li class="max-md:hidden"><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href="/quick-quote/" data-ask-ai><Sparkles class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.studioLive ? 'Ask Max' : 'Get a quote'}</a></li>
        <li class="max-md:hidden"><a class="flex items-center gap-3 text-zinc-800 dark:text-zinc-200" href={`mailto:${business.email}`}><Mail class="w-5 h-5 text-violet-600 dark:text-violet-300" aria-hidden="true" />{business.email}</a></li>
        <li class="flex items-start gap-3 max-md:gap-2 text-zinc-800 dark:text-zinc-200"><MapPin class="w-5 h-5 max-md:w-4 max-md:h-4 mt-0.5 text-violet-600 dark:text-violet-300 shrink-0" aria-hidden="true" /><span>{business.address.streetAddress}, {business.address.addressLocality}, {business.address.addressRegion} {business.address.postalCode}<br /><span class="muted">and Cleveland, Ohio</span></span></li>
      </ul>
    </div>
  </div>
  <div class="bg-zinc-100 dark:bg-white/[0.04]">
    <div class="wrap py-5 max-md:py-3.5 flex flex-wrap items-center justify-between gap-3 max-md:gap-x-3 max-md:gap-y-1 text-[13px] max-md:text-[12px] muted">
      <span class="flex items-center gap-3"><span class="max-md:hidden"><BrandMark size="sm" /></span>© {new Date().getFullYear()} {business.name}</span>
      <span class="flex flex-wrap gap-4 max-md:gap-0 max-md:-mx-2"><a class="max-md:px-2 max-md:py-2.5" href="/privacy-policy/">Privacy policy</a><a class="max-md:px-2 max-md:py-2.5" href="/terms-conditions/">Terms</a><a class="max-md:px-2 max-md:py-2.5" href="/catalog/">Custom products</a></span>
    </div>
  </div>
</footer>
<script is:inline>
  // Phones: footer link groups start collapsed. From md up they are plain, always-open lists.
  (() => {
    const mq = matchMedia('(max-width: 767px)');
    const groups = document.querySelectorAll('[data-fgroup]');
    const set = () => groups.forEach((d) => { d.open = !mq.matches; });
    set();
    mq.addEventListener('change', set);
    groups.forEach((d) => d.querySelector('summary').addEventListener('click', (e) => { if (!mq.matches) e.preventDefault(); }));
  })();
</script>
