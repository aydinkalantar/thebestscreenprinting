---
import { business } from '../data/business';
import { ArrowRight, Phone } from '@lucide/astro';
interface Props { title?: string; text?: string }
const { title = 'Let’s make something people want to wear.', text = `Send the idea, the quantity and the deadline. You’ll have a personal quote within one business day.` } = Astro.props;
---
<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-600 via-violet-600 to-violet-800 p-8 sm:p-12 text-white">
  <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
  <div class="relative max-w-2xl">
    <h2 class="text-3xl font-bold">{title}</h2>
    <p class="mt-3 text-violet-100">{text}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/quick-quote/" class="btn bg-white text-violet-700 hover:bg-violet-50">Get a quote<ArrowRight class="w-4 h-4" aria-hidden="true" /></a>
      <a href={`tel:${business.phone}`} class="btn border border-white/30 text-white hover:bg-white/10"><Phone class="w-4 h-4" aria-hidden="true" />{business.phoneDisplay}</a>
    </div>
  </div>
</section>
