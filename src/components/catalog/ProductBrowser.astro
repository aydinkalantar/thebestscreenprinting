---
// Product grid with client-side filters (brand, color family, decoration) and sorting.
// Used by /catalog/, the collection pages and the brand pages. Filter state lives in the URL.
import ProductCard from '../ProductCard.astro';
import { type CatalogProduct, CATEGORY_LABELS } from '../../lib/catalog';
import { COLOR_FAMILIES, DECORATION_FILTERS, productFamilies, productDecorations } from './browse';
import { SlidersHorizontal, RotateCcw, X } from '@lucide/astro';

interface Props { products: CatalogProduct[]; /** Hide the brand select (brand pages). */ hideBrand?: boolean }
const { products, hideBrand = false } = Astro.props;

const slug = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const rows = products.map((p, i) => ({ p, i, families: productFamilies(p), decos: productDecorations(p) }));
const brands = [...new Set(products.map((p) => p.brand).filter(Boolean) as string[])]
  .map((name) => ({ name, slug: slug(name), count: products.filter((p) => p.brand === name).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
const families = COLOR_FAMILIES.filter((f) => rows.some((r) => r.families.includes(f.id)));
const decorations = DECORATION_FILTERS.filter((d) => rows.some((r) => r.decos.includes(d.id)));
const showBrand = !hideBrand && brands.length > 1;
const labels = { ...CATEGORY_LABELS };
---
<div data-browser data-labels={JSON.stringify(labels)} class="mt-8">
  <div class="panel p-3 sm:p-4 grid gap-3">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="hidden sm:inline-flex items-center gap-1.5 text-[13px] font-semibold text-zinc-700 dark:text-zinc-300"><SlidersHorizontal class="w-4 h-4 text-violet-600 dark:text-violet-300" aria-hidden="true" />Filter</span>
      {showBrand && (
        <label class="flex-1 min-w-[9rem] sm:flex-none sm:w-48"><span class="sr-only">Brand</span>
          <select data-f="brand" class="field !h-9 !text-[13px] !rounded-full !py-0">
            <option value="">All brands</option>
            {brands.map((b) => <option value={b.slug}>{b.name} ({b.count})</option>)}
          </select>
        </label>
      )}
      <label class="flex-1 min-w-[9rem] sm:flex-none sm:w-44"><span class="sr-only">Sort</span>
        <select data-f="sort" class="field !h-9 !text-[13px] !rounded-full !py-0">
          <option value="">Sort: Featured</option>
          <option value="name">Sort: Name A–Z</option>
          <option value="colors">Sort: Most colors</option>
        </select>
      </label>
      <p class="sm:ml-auto w-full sm:w-auto text-[13px] muted" aria-live="polite"><b data-count class="text-zinc-900 dark:text-white">{products.length}</b> <span data-count-word>{products.length === 1 ? 'product' : 'products'}</span></p>
    </div>
    {families.length > 1 && (
      <div class="-mx-3 sm:-mx-4 px-3 sm:px-4 flex gap-2 overflow-x-auto no-scrollbar" role="group" aria-label="Color">
        {families.map((f) => (
          <button type="button" class="chip shrink-0 !h-8 !px-3" data-color={f.id} aria-pressed="false">
            <span class="w-3.5 h-3.5 rounded-full border border-zinc-300 dark:border-white/25" style={`background:${f.hex}`} aria-hidden="true"></span>{f.label}
          </button>
        ))}
      </div>
    )}
    {decorations.length > 1 && (
      <div class="-mx-3 sm:-mx-4 px-3 sm:px-4 flex gap-2 overflow-x-auto no-scrollbar" role="group" aria-label="Decoration">
        {decorations.map((d) => <button type="button" class="chip shrink-0 !h-8 !px-3" data-deco={d.id} aria-pressed="false">{d.label}</button>)}
      </div>
    )}
    <div data-active class="hidden flex-wrap items-center gap-2">
      <span data-legacy class="hidden"></span>
      <button type="button" data-reset class="btn-quiet btn-sm !h-8"><RotateCcw class="w-3.5 h-3.5" aria-hidden="true" />Clear filters</button>
    </div>
  </div>

  <ul data-grid class="mt-8 grid gap-x-5 gap-y-8 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    {rows.map(({ p, i, families: fam, decos }) => (
      <li data-i={i} data-featured={p.featured ? '1' : '0'} data-name={p.name.toLowerCase()} data-colors={p.colors.length}
        data-brand={p.brand ? slug(p.brand) : ''} data-families={fam.join(' ')} data-decos={decos.join(' ')}
        data-cat={p.category} data-sub={p.subcategory ?? ''}>
        <ProductCard p={p} />
      </li>
    ))}
  </ul>

  <div data-empty hidden class="mt-8 panel p-8 text-center">
    <p class="text-lg font-bold text-zinc-900 dark:text-white">No products match those filters</p>
    <p class="mt-2 text-sm muted">Try fewer filters, or tell us what you need. We print on almost anything.</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <button type="button" data-reset class="btn-primary"><RotateCcw class="w-4 h-4" aria-hidden="true" />Reset filters</button>
      <a href="/quick-quote/" class="btn-quiet">Ask for a quote</a>
    </div>
  </div>
</div>
<template id="legacy-chip"><button type="button" class="chip is-on !h-8 !px-3" data-legacy-clear><span></span><X class="w-3.5 h-3.5" aria-hidden="true" /></button></template>

<script>
  document.querySelectorAll<HTMLElement>('[data-browser]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = [...grid.querySelectorAll<HTMLElement>('li[data-i]')];
    const brandSel = root.querySelector<HTMLSelectElement>('[data-f="brand"]');
    const sortSel = root.querySelector<HTMLSelectElement>('[data-f="sort"]')!;
    const colorChips = [...root.querySelectorAll<HTMLButtonElement>('[data-color]')];
    const decoChips = [...root.querySelectorAll<HTMLButtonElement>('[data-deco]')];
    const count = root.querySelector('[data-count]')!;
    const countWord = root.querySelector('[data-count-word]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const active = root.querySelector<HTMLElement>('[data-active]')!;
    const legacySlot = root.querySelector<HTMLElement>('[data-legacy]')!;
    const labels: Record<string, string> = JSON.parse(root.dataset.labels || '{}');

    const params = new URLSearchParams(location.search);
    const list = (k: string) => (params.get(k) || '').split(',').filter(Boolean);
    const state = {
      brand: params.get('brand') || '',
      colors: new Set(list('color')),
      decos: new Set(list('deco')),
      sort: params.get('sort') || '',
      // Old menu links: /catalog/?cat=kids or ?sub=dad-hats, when no collection page matches.
      cat: params.get('cat') || '',
      sub: params.get('sub') || '',
    };
    if (brandSel) {
      if ([...brandSel.options].some((o) => o.value === state.brand)) brandSel.value = state.brand; else state.brand = '';
    } else state.brand = '';
    if ([...sortSel.options].some((o) => o.value === state.sort)) sortSel.value = state.sort; else state.sort = '';

    const syncUrl = () => {
      const q = new URLSearchParams(location.search);
      const set = (k: string, v: string) => (v ? q.set(k, v) : q.delete(k));
      set('brand', state.brand); set('color', [...state.colors].join(',')); set('deco', [...state.decos].join(','));
      set('sort', state.sort); set('cat', state.cat); set('sub', state.sub);
      const s = q.toString().replace(/%2C/g, ',');
      history.replaceState(history.state, '', s ? `?${s}` : location.pathname);
    };

    const apply = () => {
      const has = (attr: string | undefined, set: Set<string>) => !set.size || (attr || '').split(' ').some((v) => set.has(v));
      let shown = 0;
      for (const li of items) {
        const ok = (!state.brand || li.dataset.brand === state.brand)
          && has(li.dataset.families, state.colors) && has(li.dataset.decos, state.decos)
          && (!state.cat || li.dataset.cat === state.cat) && (!state.sub || li.dataset.sub === state.sub);
        li.hidden = !ok;
        if (ok) shown++;
      }
      const sorted = [...items].sort((a, b) => {
        if (state.sort === 'name') return a.dataset.name!.localeCompare(b.dataset.name!);
        if (state.sort === 'colors') return Number(b.dataset.colors) - Number(a.dataset.colors) || Number(a.dataset.i) - Number(b.dataset.i);
        return Number(b.dataset.featured) - Number(a.dataset.featured) || Number(a.dataset.i) - Number(b.dataset.i);
      });
      sorted.forEach((li) => grid.appendChild(li));
      count.textContent = String(shown);
      countWord.textContent = shown === 1 ? 'product' : 'products';
      empty.hidden = shown > 0;
      grid.classList.toggle('hidden', shown === 0);
      grid.classList.toggle('grid', shown > 0);
      colorChips.forEach((c) => { const on = state.colors.has(c.dataset.color!); c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      decoChips.forEach((c) => { const on = state.decos.has(c.dataset.deco!); c.classList.toggle('is-on', on); c.setAttribute('aria-pressed', String(on)); });
      const filtered = !!(state.brand || state.colors.size || state.decos.size || state.cat || state.sub);
      active.classList.toggle('hidden', !filtered);
      active.classList.toggle('flex', filtered);
      legacySlot.replaceChildren();
      if (state.cat || state.sub) {
        const tpl = document.getElementById('legacy-chip') as HTMLTemplateElement;
        const chip = tpl.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
        const raw = state.sub || state.cat;
        chip.querySelector('span')!.textContent = labels[raw] || raw.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
        chip.setAttribute('aria-label', 'Remove category filter');
        chip.addEventListener('click', () => { state.cat = ''; state.sub = ''; update(); });
        legacySlot.append(chip);
        legacySlot.className = '';
      } else legacySlot.className = 'hidden';
    };
    const update = () => { apply(); syncUrl(); };

    brandSel?.addEventListener('change', () => { state.brand = brandSel.value; update(); });
    sortSel.addEventListener('change', () => { state.sort = sortSel.value; update(); });
    const toggle = (set: Set<string>, v: string) => (set.has(v) ? set.delete(v) : set.add(v));
    colorChips.forEach((c) => c.addEventListener('click', () => { toggle(state.colors, c.dataset.color!); update(); }));
    decoChips.forEach((c) => c.addEventListener('click', () => { toggle(state.decos, c.dataset.deco!); update(); }));
    root.querySelectorAll('[data-reset]').forEach((b) => b.addEventListener('click', () => {
      Object.assign(state, { brand: '', cat: '', sub: '' });
      state.colors.clear(); state.decos.clear();
      if (brandSel) brandSel.value = '';
      update();
    }));
    apply();
  });
</script>
