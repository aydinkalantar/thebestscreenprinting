---
// The TBSP shield on its own: black (positive) in light mode, white (negative)
// in dark mode.
import { business } from '../data/business';
interface Props { size?: 'sm' | 'md'; class?: string; /** Show the TBSP name beside the shield on phones. */ wordmark?: boolean }
const { size = 'md', class: cls, wordmark = false } = Astro.props;
const s = size === 'sm' ? 'h-8 w-8' : 'h-9 w-9';
---
<a href="/" class:list={['flex items-center shrink-0', cls]} aria-label={`${business.shortName} home`}>
  <img src="/images/brand/tbsp-mark.svg" alt={business.shortName} width="40" height="40" class:list={[s, 'dark:hidden']} />
  <img src="/images/brand/tbsp-mark-negative.svg" alt={business.shortName} width="40" height="40" class:list={[s, 'hidden dark:block']} />
  {wordmark && <span class="md:hidden ml-2 text-[19px] font-semibold tracking-tight leading-none text-zinc-900 dark:text-white" aria-hidden="true">TBSP</span>}
</a>
