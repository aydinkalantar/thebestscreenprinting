---
// The TBSP logo (orange shield + "tbsp" wordmark). The wordmark is dark in light
// mode and white in dark mode; the shield stays the brand orange in both.
import { business } from '../data/business';
interface Props { size?: 'sm' | 'md' }
const { size = 'md' } = Astro.props;
const h = size === 'sm' ? 'h-7' : 'h-8';
---
<a href="/" class="flex items-center shrink-0" aria-label={`${business.shortName} home`}>
  <img src="/images/brand/tbsp-logo-on-light.svg" alt={business.shortName} width="139" height="50" class:list={[h, 'w-auto dark:hidden']} />
  <img src="/images/brand/tbsp-logo-on-dark.svg" alt={business.shortName} width="139" height="50" class:list={[h, 'w-auto hidden dark:block']} />
</a>
