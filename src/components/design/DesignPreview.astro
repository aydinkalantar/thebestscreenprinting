---
// Design preview: the garment photo for the selected color with the customer's artwork placed
// on it. All behaviour lives in design.ts; the product page mounts it and wires the quote panel.
import { techniqueNames, type CatalogProduct } from '../../lib/catalog';
import { spotsFor, placeConfigFor, applyPrintAreas, type Overrides, type PrintAreas } from './areas';
import overrides from '../../../data/print-area-overrides.json';
import { Upload, Crosshair, RotateCcw, Trash2, ZoomIn, ZoomOut, Replace, Info, Eye } from '@lucide/astro';

interface Props { p: CatalogProduct }
const { p } = Astro.props;
const printAreas = (p as { printAreas?: PrintAreas }).printAreas ?? null;
const spots = applyPrintAreas(spotsFor(p), printAreas);
const first = p.colors[0];
const front = first?.image || p.image;
const back = first?.back || '';
const methods = techniqueNames(p.techniques);
const place = placeConfigFor(p, (overrides as Record<string, Overrides>)[p.id]);
const config = { spots, decorations: methods.length ? methods : ['Not sure yet'], name: p.name, place, style: p.image, printAreas };
const first0 = spots[0];
const chip = 'chip relative shrink-0 cursor-pointer select-none aria-pressed:border-violet-500 aria-pressed:bg-violet-500/10 aria-pressed:text-violet-700 dark:aria-pressed:text-violet-300 max-md:h-10';
const tool = 'btn-quiet btn-sm max-md:h-11 max-md:px-3';
---
<section id="design" data-design data-config={JSON.stringify(config)} aria-labelledby="design-title" class="relative min-w-0 scroll-mt-24">
  <div class="absolute inset-8 rounded-[2rem] bg-violet-500/15 blur-3xl max-md:hidden" aria-hidden="true"></div>
  <div class="relative md:panel-raised md:p-4 max-md:-mx-4">
    <div class="flex items-center justify-between gap-3 max-md:px-4 max-md:pt-1 max-md:pb-3 md:mb-3">
      <h2 id="design-title" class="text-[15px] font-bold text-zinc-900 dark:text-white">Design preview</h2>
      <div role="tablist" aria-label="Garment side" class="inline-flex p-1 rounded-xl bg-zinc-100 dark:bg-white/[0.06]" data-tabs>
        <button type="button" role="tab" data-side="front" aria-selected="true" aria-controls="design-stage" class="tab">Front</button>
        <button type="button" role="tab" data-side="back" aria-selected="false" aria-controls="design-stage" class="tab" hidden={!back}>Back</button>
      </div>
    </div>

    <div class="relative mx-auto" data-stage-wrap style="width:min(100%, calc(var(--stage-h) * 0.8))">
      <div id="design-stage" role="tabpanel" aria-label="Garment preview" data-stage
        class="relative w-full overflow-hidden bg-zinc-50 dark:bg-white/[0.04] md:rounded-xl select-none" style="aspect-ratio:4/5">
        <div data-zoomer class="absolute inset-0 origin-top-left transition-transform duration-300 ease-out">
          <img data-photo src={front} alt={`${p.name}, front`} crossorigin="anonymous" width="1000" height="1250" decoding="async" class="absolute inset-0 w-full h-full object-fill pointer-events-none" draggable="false" />
          <div data-layer class="absolute inset-0"></div>
        </div>
        <p data-stage-note hidden class="absolute left-2 right-2 bottom-2 rounded-lg bg-white/90 dark:bg-black/70 px-2.5 py-1.5 text-[12px] font-medium text-zinc-700 dark:text-zinc-200 text-center"></p>
        <button type="button" data-clean aria-pressed="false" class="absolute left-2 top-2 inline-flex items-center gap-1.5 h-10 px-3.5 rounded-full border border-zinc-200 dark:border-white/10 bg-white/90 dark:bg-black/60 backdrop-blur text-[13px] font-semibold text-zinc-800 dark:text-zinc-100 hover:border-violet-300 aria-pressed:bg-violet-600 aria-pressed:text-white aria-pressed:border-violet-600" title="Show the product without guides"><Eye class="w-4 h-4" aria-hidden="true" /><span data-clean-label>Preview</span></button>
        <button type="button" data-zoom hidden class="absolute right-2 top-2 icon-btn w-10 h-10 rounded-full bg-white/90 dark:bg-black/60 backdrop-blur" aria-pressed="false" aria-label="Zoom in on the print area"><ZoomIn data-zoom-in class="w-[18px] h-[18px]" aria-hidden="true" /><ZoomOut data-zoom-out class="hidden w-[18px] h-[18px]" aria-hidden="true" /></button>
      </div>
    </div>

    <div class="mt-3 max-md:px-4">
      <p class="sr-only" id="design-loc-label">Print location</p>
      <div data-chips role="group" aria-labelledby="design-loc-label" class="flex gap-2 md:flex-wrap max-md:overflow-x-auto no-scrollbar max-md:-mx-4 max-md:px-4 py-0.5">
        {spots.map((s, i) => (
          <button type="button" class={chip} data-loc={s.id} data-side-of={s.side} aria-pressed={i === 0 ? 'true' : 'false'} hidden={s.side === 'back' && !back}>
            <span data-dot class="hidden w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>{s.label}<span class="sr-only" data-has> (no artwork)</span>
          </button>
        ))}
      </div>

      <!-- Artwork carried over from another product in the quote ("Use same artwork"). -->
      <div data-pending hidden class="mt-3 rounded-2xl border border-violet-300/70 dark:border-violet-400/30 bg-violet-500/[0.06] p-3 sm:p-4 grid gap-2" role="region" aria-label="Artwork from your quote">
        <div class="flex items-start gap-2">
          <p class="min-w-0 flex-1 text-[13px] leading-snug text-zinc-800 dark:text-zinc-200" data-pending-note></p>
          <button type="button" data-pending-dismiss class="shrink-0 min-h-[32px] text-[12.5px] font-semibold text-violet-700 dark:text-violet-300 hover:underline">Dismiss</button>
        </div>
        <ul data-pending-list class="grid gap-2"></ul>
      </div>

      <div data-panel class="mt-3 rounded-2xl border border-zinc-200/80 dark:border-white/10 bg-zinc-50/70 dark:bg-white/[0.03] p-3 sm:p-4">
        <!-- Empty location -->
        <div data-empty class="flex flex-wrap items-center gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-[14px] font-semibold text-zinc-900 dark:text-white" data-loc-name>{first0?.label}</p>
            <p class="text-[12.5px] muted" data-loc-size>Print area up to {first0?.wIn}" × {first0?.hIn}"</p>
          </div>
          <button type="button" data-add class="btn-primary btn-sm max-md:h-11 max-md:w-full"><Upload class="w-4 h-4" aria-hidden="true" /><span data-add-label>Add artwork</span></button>
          <p class="basis-full text-[12px] muted">PNG, JPG, SVG, PDF, AI or PSD · up to 10 MB each, 25 MB in total</p>
        </div>

        <!-- Location with artwork -->
        <div data-filled hidden class="grid gap-3">
          <div class="flex items-start gap-3">
            <div class="min-w-0 flex-1">
              <p class="text-[14px] font-semibold text-zinc-900 dark:text-white"><span data-loc-name>Front</span> · <span data-file class="font-medium muted break-all"></span></p>
              <p class="text-[12.5px] muted" id="design-readout" data-readout aria-live="off"></p>
            </div>
            <button type="button" data-replace class={tool} aria-label="Replace artwork"><Replace class="w-4 h-4" aria-hidden="true" /><span class="max-sm:sr-only">Replace</span></button>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="label"><span>Decoration</span>
              <select data-decoration class="field !h-10 max-md:!h-11">
                {config.decorations.map((d) => <option value={d}>{d}</option>)}
              </select>
            </label>
            <label class="label"><span>Notes <small>(optional)</small></span>
              <input data-notes class="field !h-10 max-md:!h-11" maxlength="300" placeholder="Ink/thread colors, PMS…" autocomplete="off" />
            </label>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-center class={tool}><Crosshair class="w-4 h-4" aria-hidden="true" />Center</button>
            <button type="button" data-reset class={tool}><RotateCcw class="w-4 h-4" aria-hidden="true" />Reset</button>
            <button type="button" data-remove class={`${tool} text-red-600 dark:text-red-400`}><Trash2 class="w-4 h-4" aria-hidden="true" />Remove</button>
          </div>
          <p class="text-[12px] muted max-md:hidden">Drag to move, drag the corner to resize. Or select the artwork and use the arrow keys (Shift for bigger steps) and + / − to resize.</p>
          <p class="text-[12px] muted md:hidden">Drag to move, drag the corner handle to resize.</p>
        </div>
      </div>

      <input type="file" data-file-input class="sr-only" tabindex="-1" aria-hidden="true" accept="image/*,.pdf,.ai,.psd,.svg" />
      <p data-error role="alert" aria-live="assertive" class="err mt-2"></p>
      <p class="sr-only" aria-live="polite" data-announce></p>
      <p class="mt-3 flex gap-1.5 text-[12.5px] muted"><Info class="w-4 h-4 shrink-0 mt-px" aria-hidden="true" />Mockups are a visual guide. Final print size, placement and colors are confirmed on your proof before production.</p>
    </div>
  </div>
</section>

<style is:global>
  /* `hidden` must win over display utilities (grid, flex) used on the same elements. */
  [data-design] [hidden], #design-request [hidden] { display: none !important; }
  [data-design] .tab { height: 2rem; padding: 0 .9rem; border-radius: .65rem; font-size: 13px; font-weight: 600; color: rgb(113 113 122); }
  [data-design] .tab[aria-selected="true"] { background: #fff; color: rgb(24 24 27); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
  .dark [data-design] .tab { color: rgb(161 161 170); }
  .dark [data-design] .tab[aria-selected="true"] { background: rgba(255,255,255,.12); color: #fff; }
  @media (max-width: 767px) { [data-design] .tab { height: 2.5rem; padding: 0 1.1rem; } }

  /* Print areas and artwork on the stage. */
  [data-design] { --stage-h: min(70vh, 680px); }
  @media (max-width: 767px) { [data-design] { --stage-h: 58svh; } }
  [data-design] .d-area { position: absolute; pointer-events: none; z-index: 1; }
  [data-design] .d-area.is-active { z-index: 2; }
  [data-design] .d-area.is-active { outline: calc(1.5px / var(--z)) dashed rgb(139 92 246); outline-offset: 0; background: rgba(139, 92, 246, .06); }
  [data-design] .d-area-label { position: absolute; left: 0; bottom: 100%; margin-bottom: 3px; white-space: nowrap; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: rgb(124 58 237); background: rgba(255,255,255,.88); padding: 1px 5px; border-radius: 4px; pointer-events: none; }
  .dark [data-design] .d-area-label { background: rgba(10,10,15,.8); color: rgb(196 181 253); }
  [data-design] .d-art { position: absolute; pointer-events: auto; touch-action: none; cursor: grab; outline: none; }
  [data-design] .d-art:active { cursor: grabbing; }
  [data-design] .d-art img { width: 100%; height: 100%; object-fit: fill; pointer-events: none; user-select: none; -webkit-user-drag: none; }
  [data-design] .d-art.is-active { box-shadow: 0 0 0 calc(1.5px / var(--z)) rgb(124 58 237); }
  [data-design] .d-art:focus-visible { box-shadow: 0 0 0 2px #fff, 0 0 0 4px rgb(124 58 237); }
  [data-design] .d-ph { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 4px; overflow: hidden; border: calc(1.5px / var(--z)) dashed rgb(124 58 237); background: rgba(255,255,255,.82); color: rgb(76 29 149); text-align: center; font-weight: 700; line-height: 1.1; container-type: size; }
  [data-design] .d-ph b { font-size: clamp(7px, 22cqmin, 15px); }
  [data-design] .d-ph span { font-size: clamp(6px, 11cqmin, 11px); font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Guides step back so the artwork reads as it will print: on hover-capable screens they show
     only while the pointer is on the garment (or something in it has focus); "Preview" hides them everywhere. */
  [data-design] .d-area, [data-design] .d-area-label, [data-design] .d-handle, [data-design] .d-art { transition: outline-color .2s, background-color .2s, opacity .2s, box-shadow .2s; }
  @media (hover: hover) {
    [data-design] [data-stage]:not(:hover):not(:focus-within):not(.is-drop) .d-area.has-art { outline-color: transparent; background: transparent; }
    [data-design] [data-stage]:not(:hover):not(:focus-within):not(.is-drop) .d-area.has-art .d-area-label,
    [data-design] [data-stage]:not(:hover):not(:focus-within):not(.is-drop) .d-handle { opacity: 0; }
    [data-design] [data-stage]:not(:hover):not(:focus-within):not(.is-drop) .d-art.is-active { box-shadow: none; }
  }
  [data-design] [data-stage].is-clean .d-area { outline-color: transparent !important; background: transparent !important; }
  [data-design] [data-stage].is-clean .d-area-label, [data-design] [data-stage].is-clean .d-handle, [data-design] [data-stage].is-clean .d-drop { opacity: 0 !important; pointer-events: none; }
  [data-design] [data-stage].is-clean .d-art { box-shadow: none !important; }
  [data-design] .d-drop { position: absolute; inset: 0; pointer-events: auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 6px; color: rgb(109 40 217); text-align: center; cursor: pointer; container-type: size; border-radius: 2px; transition: background .15s; }
  [data-design] .d-drop:hover, [data-design] .d-drop:focus-visible, [data-design] [data-stage].is-drop .d-drop { background: rgba(139, 92, 246, .16); }
  [data-design] .d-drop:focus-visible { outline: 2px solid rgb(124 58 237); outline-offset: 2px; }
  [data-design] .d-drop svg { width: clamp(14px, 18cqmin, 30px); height: clamp(14px, 18cqmin, 30px); padding: clamp(3px, 4cqmin, 7px); box-sizing: content-box; border-radius: 9999px; background: rgb(124 58 237); color: #fff; }
  [data-design] .d-drop b { font-size: clamp(8px, 9cqmin, 15px); font-weight: 700; background: rgba(255,255,255,.85); padding: 1px 6px; border-radius: 6px; }
  [data-design] .d-drop span { font-size: clamp(7px, 6.5cqmin, 12px); font-weight: 600; color: rgb(82 82 91); background: rgba(255,255,255,.75); padding: 0 5px; border-radius: 5px; }
  @container (max-height: 70px) { [data-design] .d-drop span { display: none; } }
  @container (max-width: 90px) { [data-design] .d-drop b { display: none; } }
  .dark [data-design] .d-drop b, .dark [data-design] .d-drop span { background: rgba(10,10,15,.75); color: rgb(221 214 254); }
  [data-design] [data-stage].is-drop { outline: 2px dashed rgb(124 58 237); outline-offset: -2px; }
  [data-design] .d-handle { position: absolute; right: -11px; bottom: -11px; width: 22px; height: 22px; border-radius: 9999px; background: rgb(124 58 237); border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.3); cursor: nwse-resize; touch-action: none; }
  /* Bigger hit area, grown outward so it never covers the artwork itself (that would block moving it). */
  [data-design] .d-handle::before { content: ''; position: absolute; inset: -2px -14px -14px -2px; }
  @media (pointer: coarse) { [data-design] .d-handle { width: 28px; height: 28px; right: -14px; bottom: -14px; } }
  [data-design] .d-art.is-tiny .d-handle { right: -26px; bottom: -26px; }
  [data-design] .d-art.is-tiny .d-handle::before { inset: -10px; }
  /* Handles and labels stay the same size when the stage zooms in. */
  [data-design] [data-zoomer] { --z: 1; }
  [data-design] .d-handle, [data-design] .d-area-label { transform: scale(calc(1 / var(--z))); }
  [data-design] .d-handle { transform-origin: 50% 50%; }
  [data-design] .d-area-label { transform-origin: 0 100%; }
</style>
