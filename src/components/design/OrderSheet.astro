---
// Checkout step for "Order & pay": contact, pickup or shipping, full or deposit, then the
// studio creates the order + invoice and we go to its secure card payment page.
// Product pages and the quote cart fill it from src/lib/online.ts price answers.
import { X, Lock, ShieldCheck } from '@lucide/astro';
import { LEAD_SOURCES } from '../../lib/quote';
import { business } from '../../data/business';

const US_STATES = 'AL AK AZ AR CA CO CT DE DC FL GA HI ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY'.split(' ');

const radio = 'flex items-start gap-3 rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/[0.03] px-3.5 py-2.5 cursor-pointer has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-violet-500';
---
<div id="order-sheet" data-sheet="modal" hidden role="dialog" aria-modal="true" aria-labelledby="order-sheet-title" class="fixed inset-0 z-[100] flex items-end md:items-center justify-center md:p-6">
  <div class="absolute inset-0 bg-black/45" data-sheet-backdrop data-sheet-close></div>
  <div data-sheet-panel class="relative w-full md:max-w-xl max-h-[92dvh] md:max-h-[88vh] flex flex-col bg-white dark:bg-[#0d0d14] rounded-t-3xl md:rounded-2xl shadow-2xl border border-zinc-200/80 dark:border-white/10 max-md:border-x-0 max-md:border-b-0">
    <div class="shrink-0 px-5 pt-2 pb-3 border-b border-zinc-200/80 dark:border-white/10" data-sheet-grip>
      <div class="md:hidden mx-auto mb-2 h-1.5 w-10 rounded-full bg-zinc-300 dark:bg-white/20" aria-hidden="true"></div>
      <div class="flex items-center justify-between gap-3 md:pt-2">
        <h2 id="order-sheet-title" class="text-lg font-bold text-zinc-900 dark:text-white">Order &amp; pay</h2>
        <button type="button" class="icon-btn w-10 h-10 rounded-xl" data-sheet-close aria-label="Close"><X class="w-[18px] h-[18px]" aria-hidden="true" /></button>
      </div>
      <p data-os-summary class="mt-1 text-[13px] muted"></p>
      <div data-os-mockups style="display:none" class="mt-2 gap-2 overflow-x-auto no-scrollbar"></div>
    </div>

    <form data-os-form class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 py-4 grid gap-5 content-start" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="label"><span>Name</span><input name="name" class="field" autocomplete="name" autocapitalize="words" required data-sheet-focus /><span class="err" data-for="name"></span></label>
        <label class="label"><span>Email</span><input name="email" class="field" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" required /><span class="err" data-for="email"></span></label>
        <label class="label"><span>Phone <small>(optional)</small></span><input name="phone" class="field" type="tel" inputmode="tel" autocomplete="tel" /></label>
        <label class="label"><span>Company or team <small>(optional)</small></span><input name="company" class="field" autocomplete="organization" /></label>
      </div>

      <fieldset data-os-delivery class="grid gap-2">
        <legend class="label mb-2">Delivery</legend>
        <label class={radio} data-os-pickup><input type="radio" name="delivery" value="pickup" class="mt-1 accent-violet-600" /><span class="min-w-0 text-[13.5px] leading-snug"><span class="font-semibold text-zinc-900 dark:text-white">Pickup</span> <span class="muted">· free</span><span data-os-pickup-note class="block text-[12.5px] muted"></span></span></label>
        <label class={radio} data-os-ship><input type="radio" name="delivery" value="ship" class="mt-1 accent-violet-600" /><span class="min-w-0 text-[13.5px] leading-snug"><span class="font-semibold text-zinc-900 dark:text-white">Shipping</span> <span data-os-ship-price class="muted"></span><span class="block text-[12.5px] muted">Anywhere in the US</span></span></label>
      </fieldset>

      <!-- Shown only when the studio prices turnaround (totals.rush in its answer). -->
      <fieldset data-os-turn hidden class="grid gap-2">
        <legend class="label mb-2">Turnaround</legend>
        {business.turnaround.map((t, i) => (
          <label class={radio} data-os-turn-opt={t.id.replace('-', '')}>
            <input type="radio" name="turnaround" value={t.id.replace('-', '')} checked={i === 0} class="mt-1 accent-violet-600" />
            <span class="min-w-0 text-[13.5px] leading-snug">
              <span class="font-semibold text-zinc-900 dark:text-white">{t.name}</span><span class="muted" data-os-turn-meta> · {t.time}{t.fee ? ` · ${t.fee}` : ''}</span>
              <span class="block text-[12.5px] muted" data-os-ready={t.id.replace('-', '')}></span>
            </span>
          </label>
        ))}
        <p data-os-turn-err hidden class="text-[13px] font-medium text-red-600 dark:text-red-400"></p>
        <p class="text-[12px] muted">{business.superRushNote} Turnaround starts once your proof is approved.</p>
      </fieldset>

      <div data-os-address hidden class="grid gap-4 sm:grid-cols-6">
        <label class="label sm:col-span-6"><span>Street address</span><input name="street" class="field" autocomplete="shipping address-line1" autocapitalize="words" /><span class="err" data-for="address"></span></label>
        <label class="label sm:col-span-6"><span>Apt, suite, unit <small>(optional)</small></span><input name="street2" class="field" autocomplete="shipping address-line2" /></label>
        <label class="label sm:col-span-3"><span>City</span><input name="city" class="field" autocomplete="shipping address-level2" autocapitalize="words" /></label>
        <label class="label sm:col-span-1"><span>State</span>
          <select name="state" class="field !px-2" autocomplete="shipping address-level1">
            <option value=""></option>
            {US_STATES.map((st) => <option value={st}>{st}</option>)}
          </select>
        </label>
        <label class="label sm:col-span-2"><span>ZIP</span><input name="zip" class="field" autocomplete="shipping postal-code" inputmode="numeric" maxlength="10" /></label>
        <input type="hidden" name="country" value="US" autocomplete="shipping country" />
      </div>

      <fieldset data-os-pay class="grid gap-2">
        <legend class="label mb-2">Payment</legend>
        <label class={radio} data-os-full><input type="radio" name="pay" value="full" class="mt-1 accent-violet-600" /><span class="min-w-0 text-[13.5px] leading-snug"><span class="font-semibold text-zinc-900 dark:text-white">Pay in full</span> <span data-os-full-amount class="muted"></span></span></label>
        <label class={radio} data-os-deposit><input type="radio" name="pay" value="deposit" class="mt-1 accent-violet-600" /><span class="min-w-0 text-[13.5px] leading-snug"><span class="font-semibold text-zinc-900 dark:text-white">Pay a deposit now</span> <span data-os-deposit-amount class="muted"></span><span class="block text-[12.5px] muted">The rest is due before your order ships or is picked up.</span></span></label>
      </fieldset>

      <label class="label"><span>Notes <small>(optional)</small></span><textarea name="notes" rows="2" class="field !h-auto py-2.5" maxlength="2000" placeholder="Ink or thread colors, deadline, anything else"></textarea></label>
      <label class="label"><span>How did you find us? <small>(optional)</small></span>
        <select name="leadSource" class="field"><option value="">Choose one</option>{LEAD_SOURCES.map((l) => <option value={l.id}>{l.label}</option>)}</select>
      </label>

      <dl data-os-totals class="rounded-2xl bg-zinc-50 dark:bg-white/[0.04] px-4 py-3 grid grid-cols-[1fr_auto] gap-y-1.5 text-[14px]"></dl>
      <p class="flex gap-2 text-[12.5px] muted"><ShieldCheck class="w-4 h-4 shrink-0 mt-px text-emerald-600" aria-hidden="true" />We email you an art proof to approve before anything prints. If something can't be printed as ordered, we contact you first.</p>
      <p data-os-msg class="hidden" role="alert"></p>
    </form>

    <div class="shrink-0 px-5 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] border-t border-zinc-200/80 dark:border-white/10">
      <button type="submit" data-os-send class="btn-primary w-full h-12 text-[15px] aria-busy:cursor-wait aria-disabled:opacity-60"><Lock class="w-4 h-4" aria-hidden="true" /><span>Continue to secure payment</span></button>
      <p class="mt-2 text-center text-[12px] muted">Card payment by Stripe. We never see your card number.</p>
    </div>
  </div>
</div>

<style is:global>
  #order-sheet [hidden] { display: none !important; }
</style>
