---
import { business } from '../data/business';
import { Clock, Zap, Rocket } from '@lucide/astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const icons = { normal: Clock, rush: Zap, 'super-rush': Rocket } as const;
---
<div class:list={['grid gap-3', compact ? 'sm:grid-cols-3' : 'md:grid-cols-3']}>
  {business.turnaround.map((t) => {
    const Icon = icons[t.id as keyof typeof icons];
    return (
      <div class:list={['panel p-5', t.id === 'super-rush' && 'border-violet-400/60 dark:border-violet-400/40']}>
        <div class="flex items-center gap-3">
          <span class="tile-icon"><Icon class="w-5 h-5" aria-hidden="true" /></span>
          <strong class="text-zinc-900 dark:text-white">{t.name}</strong>
        </div>
        <p class="mt-3 text-lg font-bold text-zinc-900 dark:text-white">{t.time}{t.fee && <span class="ml-2 text-sm font-semibold text-violet-700 dark:text-violet-300">{t.fee} of order</span>}</p>
        <p class="mt-1 text-sm muted">{t.note}</p>
        {t.id === 'super-rush' && <p class="mt-2 text-[12px] muted">{business.superRushNote}</p>}
      </div>
    );
  })}
</div>
