---
// Animated slice of TBSP's ordering flow for the homepage hero: a request types into Max's bar,
// the garment turns the color the moment it's named, a real-looking design drops onto the front,
// then the garment turns to show its back print, and a quote chip slides in. Three products, each
// with its own artwork. Respects prefers-reduced-motion (shows the first finished scene).
import { Mic, Sparkles, Check } from '@lucide/astro';

// Designs are inline SVG in the garment's ink (currentColor), sized by the print box.
const tour = `<svg viewBox="0 0 200 150" fill="currentColor"><path id="arc1" d="M22 92 A78 78 0 0 1 178 92" fill="none"/><text font-family="Outfit,sans-serif" font-weight="800" font-size="22" letter-spacing="3"><textPath href="#arc1" startOffset="50%" text-anchor="middle">NIGHT DRIVE</textPath></text><path d="M100 54l7 15 16 2-12 11 3 16-14-8-14 8 3-16-12-11 16-2z" fill="#f5b301"/><text x="100" y="128" text-anchor="middle" font-family="Outfit,sans-serif" font-weight="800" font-size="30" letter-spacing="1">TOUR '26</text></svg>`;
const tourBack = `<svg viewBox="0 0 200 230" fill="currentColor" font-family="Outfit,sans-serif" font-weight="800" text-anchor="middle"><text x="100" y="40" font-size="30" letter-spacing="2">NIGHT DRIVE</text><rect x="40" y="52" width="120" height="3" fill="#f5b301"/>${['LOS ANGELES · NOV 7', 'SAN DIEGO · NOV 9', 'PHOENIX · NOV 12', 'DENVER · NOV 15', 'CHICAGO · NOV 19', 'CLEVELAND · NOV 22'].map((c, i) => `<text x="100" y="${84 + i * 24}" font-size="14" font-weight="600" letter-spacing="1.5">${c}</text>`).join('')}</svg>`;
const crew = `<svg viewBox="0 0 220 120" fill="currentColor" font-family="Outfit,sans-serif" text-anchor="middle"><text x="110" y="52" font-weight="800" font-size="50" letter-spacing="-1">NIGHT</text><text x="110" y="100" font-weight="800" font-size="50" letter-spacing="-1">SHIFT</text><rect x="20" y="108" width="180" height="5" fill="#ffd7a8"/></svg>`;
const crewBack = `<svg viewBox="0 0 200 200" fill="currentColor" font-family="Outfit,sans-serif" text-anchor="middle"><text x="100" y="34" font-weight="700" font-size="20" letter-spacing="6">CREW</text><text x="100" y="150" font-weight="800" font-size="130" letter-spacing="-6">36</text><text x="100" y="186" font-weight="700" font-size="15" letter-spacing="4">LOS ANGELES</text></svg>`;
const patch = `<svg viewBox="0 0 160 90"><rect x="4" y="4" width="152" height="82" rx="16" fill="#f4f1ea" stroke="#c9a227" stroke-width="5" stroke-dasharray="2 4"/><text x="80" y="58" text-anchor="middle" font-family="Outfit,sans-serif" font-weight="800" font-size="40" fill="#14213d" letter-spacing="2">TBSP</text></svg>`;
const patchBack = `<svg viewBox="0 0 160 40" fill="currentColor"><text x="80" y="28" text-anchor="middle" font-family="Outfit,sans-serif" font-weight="800" font-size="24" letter-spacing="5">EST. 2016</text></svg>`;

const C = (id: string, side: 'f' | 'b') => `https://cdn.ssactivewear.com/Images/Color/${id}_${side}_fl.jpg`;
const scenes = [
  {
    product: 'Gildan 5000 Heavy Cotton Tee', prompt: '50 black tees for our tour, front and back print, by Friday', word: 'black',
    white: C('16813', 'f'), front: C('16787', 'f'), back: C('16787', 'b'), color: 'Black', ink: '#ffffff',
    art: { x: 50, y: 36, w: 34, svg: tour }, artBack: { x: 50, y: 40, w: 40, svg: tourBack }, chip: '50 × Black tee · Screen print, front + back',
  },
  {
    product: 'Gildan 18500 Heavy Blend Hoodie', prompt: 'Maroon hoodies for the crew, big chest print', word: 'maroon',
    white: C('19750', 'f'), front: C('30067', 'f'), back: C('30067', 'b'), color: 'Maroon', ink: '#ffffff',
    art: { x: 50, y: 39, w: 34, svg: crew }, artBack: { x: 50, y: 40, w: 34, svg: crewBack }, chip: '36 × Maroon hoodie · Rush',
  },
  {
    product: 'YP Classics 6245CM Dad Hat', prompt: 'Navy dad hats with our patch stitched on front', word: 'navy',
    white: C('51238', 'f'), front: C('51235', 'f'), back: C('51235', 'b'), color: 'Navy', ink: '#f4f1ea',
    art: { x: 50, y: 41, w: 22, svg: patch }, artBack: { x: 50, y: 40, w: 26, svg: patchBack }, chip: '24 × Navy cap · Embroidery',
  },
];
---
<div class="relative" id="hero-studio" data-scenes={JSON.stringify(scenes)}>
  <div class="absolute -inset-6 max-md:-inset-3 rounded-[2.5rem] bg-violet-500/15 blur-3xl" aria-hidden="true"></div>
  <div class="relative panel-raised p-3 sm:p-4">
    <div class="flex items-center justify-between gap-3 px-1 pb-3 max-md:pb-2">
      <span class="flex items-center gap-2 min-w-0 text-[13px] font-semibold text-zinc-800 dark:text-zinc-200">
        <span class="w-2 h-2 shrink-0 rounded-full bg-emerald-500"></span>
        <span class="truncate" data-product>{scenes[0].product}</span>
        <span class="muted font-medium shrink-0" data-color>· White</span>
      </span>
      <span class="inline-flex shrink-0 rounded-lg bg-zinc-100 dark:bg-white/[0.06] p-0.5 text-[11px] font-semibold" aria-hidden="true">
        <span data-tab="front" class="px-2.5 py-1 rounded-md transition-colors bg-violet-600 text-white">Front</span><span data-tab="back" class="px-2.5 py-1 rounded-md transition-colors muted">Back</span>
      </span>
    </div>

    <!-- The garment fills the frame; the photo's white studio background melts into the soft panel. -->
    <div class="relative aspect-[4/4.3] max-md:aspect-[4/4.4] rounded-xl overflow-hidden bg-gradient-to-b from-zinc-100 to-zinc-200">
      <div class="absolute inset-x-[4%] -top-[3%] bottom-[-6%]" data-stage>
        <img data-img-a src={scenes[0].white} alt="" class="absolute inset-0 w-full h-full object-contain mix-blend-multiply transition-opacity duration-500" />
        <img data-img-b src={scenes[0].front} alt="" class="absolute inset-0 w-full h-full object-contain mix-blend-multiply opacity-0 transition-opacity duration-500" />
        <div data-art class="absolute -translate-x-1/2 -translate-y-1/2 opacity-0 scale-50 transition-all duration-500 ease-[cubic-bezier(.34,1.56,.64,1)] [&>svg]:w-full [&>svg]:h-auto drop-shadow-[0_1px_1px_rgba(0,0,0,.25)]" style="left:50%;top:36%;width:34%"></div>
        <div data-box class="absolute -translate-x-1/2 -translate-y-1/2 rounded-md border-2 border-dashed border-violet-500/80 opacity-0 transition-opacity duration-300" style="left:50%;top:36%;width:40%;height:24%"></div>
      </div>
      <div data-chip class="absolute bottom-3 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 transition-all duration-500 flex items-center gap-2 rounded-full bg-white/95 dark:bg-[#0d0d14]/95 border border-zinc-200 dark:border-white/10 px-3.5 py-1.5 text-[12px] font-semibold text-zinc-800 dark:text-zinc-100 shadow-lg whitespace-nowrap">
        <Check class="w-3.5 h-3.5 text-emerald-500" aria-hidden="true" /><span data-chip-text>Quote ready</span>
      </div>
    </div>

    <div class="mt-3 max-md:mt-2 rounded-xl border border-zinc-200 dark:border-white/10 p-2.5 max-md:p-2 flex items-center gap-3">
      <span data-mic class="relative w-9 h-9 shrink-0 rounded-lg grid place-items-center bg-violet-600 text-white">
        <span class="absolute inset-0 rounded-lg bg-violet-500 animate-ping opacity-0" data-ping></span>
        <Mic class="relative w-4 h-4" aria-hidden="true" />
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-violet-600 dark:text-violet-300">● <span data-max-only>Max · your merch agent</span><span data-max-alt>Your order, mocked up</span></p>
        <p class="text-[13px] text-zinc-700 dark:text-zinc-300 truncate h-5"><span data-typed></span><span class="inline-block w-px h-3.5 align-middle bg-violet-500 ml-0.5 animate-pulse" aria-hidden="true"></span></p>
      </div>
      <Sparkles class="w-4 h-4 text-violet-500 shrink-0" aria-hidden="true" />
    </div>
  </div>
</div>

<script>
  type Art = { x: number; y: number; w: number; svg: string };
  type Scene = { product: string; prompt: string; word: string; white: string; front: string; back: string; color: string; ink: string; art: Art; artBack: Art; chip: string };
  const root = document.getElementById('hero-studio');
  if (root && !root.dataset.ready) {
    root.dataset.ready = '1';
    const scenes: Scene[] = JSON.parse(root.dataset.scenes!);
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const imgA = q<HTMLImageElement>('[data-img-a]'), imgB = q<HTMLImageElement>('[data-img-b]');
    const art = q('[data-art]'), box = q('[data-box]'), chip = q('[data-chip]'), chipText = q('[data-chip-text]');
    const typed = q('[data-typed]'), product = q('[data-product]'), color = q('[data-color]'), ping = q('[data-ping]');
    const tabs = { front: q('[data-tab="front"]'), back: q('[data-tab="back"]') };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    // Warm the cache so swaps are instant.
    scenes.forEach((s) => [s.white, s.front, s.back].forEach((u) => { new Image().src = u; }));

    // Two stacked photos crossfade, so a swap never flashes.
    let shown = imgA;
    const photo = (src: string) => {
      if (shown.getAttribute('src') === src) return;
      const next = shown === imgA ? imgB : imgA;
      next.src = src;
      next.classList.remove('opacity-0'); shown.classList.add('opacity-0');
      shown = next;
    };
    const tab = (side: 'front' | 'back') => {
      for (const [k, el] of Object.entries(tabs)) {
        el.classList.toggle('bg-violet-600', k === side); el.classList.toggle('text-white', k === side); el.classList.toggle('muted', k !== side);
      }
    };
    const place = (a: Art, ink: string) => {
      for (const el of [art, box]) { el.style.left = `${a.x}%`; el.style.top = `${a.y}%`; }
      art.style.width = `${a.w}%`; art.style.color = ink;
      art.innerHTML = a.svg;
      box.style.width = `${a.w + 8}%`; box.style.height = `${a.w * 0.85}%`;
    };
    const show = (el: HTMLElement, on: boolean, ...cls: string[]) => {
      el.classList.toggle('opacity-0', !on);
      cls.forEach((c) => el.classList.toggle(c, !on));
    };

    const finish = (s: Scene) => {
      photo(s.front); tab('front'); place(s.art, s.ink);
      product.textContent = s.product; color.textContent = `· ${s.color}`; typed.textContent = s.prompt;
      show(art, true, 'scale-50'); chipText.textContent = s.chip; show(chip, true, 'translate-y-4');
    };

    async function play() {
      for (let i = 0; ; i = (i + 1) % scenes.length) {
        const s = scenes[i];
        // Start on the plain white garment.
        show(art, false, 'scale-50'); show(chip, false, 'translate-y-4'); show(box, false);
        photo(s.white); tab('front');
        product.textContent = s.product; color.textContent = '· White'; typed.textContent = '';
        place(s.art, s.ink);
        await wait(700);
        // The request types itself; the garment turns the color the moment it's said.
        ping.classList.remove('opacity-0'); ping.classList.add('opacity-60');
        let colored = false;
        for (const ch of s.prompt) {
          typed.textContent += ch;
          if (!colored && typed.textContent.toLowerCase().includes(s.word)) { colored = true; photo(s.front); color.textContent = `· ${s.color}`; }
          await wait(30 + Math.random() * 36);
        }
        ping.classList.add('opacity-0'); ping.classList.remove('opacity-60');
        await wait(400);
        // The print area appears and the design drops in.
        show(box, true); await wait(350);
        show(art, true, 'scale-50'); await wait(450);
        show(box, false);
        await wait(1500);
        // Turn it around: the back print.
        show(art, false, 'scale-50'); await wait(250);
        photo(s.back); tab('back'); place(s.artBack, s.ink);
        await wait(350);
        show(art, true, 'scale-50');
        chipText.textContent = s.chip; show(chip, true, 'translate-y-4');
        await wait(2400);
      }
    }
    if (reduce) finish(scenes[0]); else play();
  }
</script>
